# Autoloop runtime state
.claude-progress.json
.claude-progress.json.tmp
.claude-progress-checkpoint-*.json

# Worktrees (v1.4)
.worktrees/

# Observability outputs (per-project, generated)
.claude/observability/metrics.jsonl
.claude/observability/refresh/raw-*.jsonl
.claude/observability/refresh/proposed-*.md
.claude/observability/security/findings-*.jsonl
.claude/observability/docs_index.yaml

# Backups
.backup-*/
.claude/.backup-*/

# ScheduleWakeup runtime lock (Claude Code internal — not source-of-truth)
.claude/scheduled_tasks.lock

# Active autoloop marker (worktree_gate runtime state — pointing at
# .worktrees/<name>; ephemeral per-loop, never source-of-truth)
.claude/.hm-loop-active

# Dogfood harness workspace (generated by harness-maker for its own dev use)
.claude/agents/
.claude/commands/
.claude/harness.yaml
.claude/hooks/
.claude/loop-specs/
.claude/memory/session/
.claude/rubrics/
.claude/settings.json
.claude/skills/
.claude/stages/

# Cursor IDE workspace
.cursor/

# Session work documents (research, plans, loop context)
work-docs/

tests/e2e/sandbox/.claude/.backup-*/
tests/e2e/sandbox-plugin-test/.claude/.backup-*/

# Cache
~/.cache/harness-maker/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python build / venv
.venv/
*.egg-info/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local env
.env
.env.local

# Phase 11 dogfood sandboxes get git init'd at test time; don't track inner repos
tests/e2e/sandbox/.git/
tests/e2e/sandbox-plugin-test/.git/
tests/e2e/sandbox/.worktrees/
tests/e2e/sandbox/.backup-*/
tests/e2e/sandbox-plugin-test/.backup-*/
