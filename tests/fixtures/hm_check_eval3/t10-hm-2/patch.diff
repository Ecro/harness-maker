@@ -0,0 +1,79 @@
+"""fetch_quota against a fake opener (SPEC quota-client S1-S3)."""
+
+import json
+import urllib.request
+
+import pytest
+from timeparse.quota import MissingTokenError, fetch_quota
+
+
+class FakeOpener:
+    def __init__(self, body: str) -> None:
+        self.body = body
+        self.requests: list[urllib.request.Request] = []
+
+    def __call__(self, request: urllib.request.Request):
+        self.requests.append(request)
+        body = self.body.encode()
+
+        class Response:
+            def read(self) -> bytes:
+                return body
+
+        return Response()
+
+
+def test_s1_fetch_quota_returns_seconds_and_builds_request(monkeypatch) -> None:
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "dummy")
+    opener = FakeOpener(json.dumps({"remaining": "1h30m"}))
+    assert fetch_quota("http://q.test", opener) == 5400
+    assert len(opener.requests) == 1
+    request = opener.requests[0]
+    assert request.full_url == "http://q.test/v1/quota"
+    assert request.get_method() == "GET"
+    assert request.get_header("Authorization") == "Bearer dummy"
+
+
+def test_s2_token_read_on_each_call(monkeypatch) -> None:
+    opener = FakeOpener(json.dumps({"remaining": "1m"}))
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "first")
+    fetch_quota("http://q.test", opener)
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "second")
+    fetch_quota("http://q.test", opener)
+    headers = [r.get_header("Authorization") for r in opener.requests]
+    assert headers == ["Bearer first", "Bearer second"]
+
+
+@pytest.mark.parametrize("token", [None, ""])
+def test_s3_missing_token_raises_without_calling_opener(monkeypatch, token) -> None:
+    if token is None:
+        monkeypatch.delenv("TIMEPARSE_TOKEN", raising=False)
+    else:
+        monkeypatch.setenv("TIMEPARSE_TOKEN", token)
+    opener = FakeOpener(json.dumps({"remaining": "1m"}))
+    with pytest.raises(MissingTokenError):
+        fetch_quota("http://q.test", opener)
+    assert opener.requests == []
+
+
+def test_missing_token_error_is_runtime_error() -> None:
+    assert issubclass(MissingTokenError, RuntimeError)
+
+
+@pytest.mark.parametrize("body", [json.dumps({"remaining": "1m"}), "not json"])
+def test_response_is_closed(monkeypatch, body) -> None:
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "dummy")
+    closed = []
+
+    class Response:
+        def read(self) -> bytes:
+            return body.encode()
+
+        def close(self) -> None:
+            closed.append(True)
+
+    try:
+        fetch_quota("http://q.test", lambda request: Response())
+    except ValueError:
+        pass
+    assert closed == [True]
