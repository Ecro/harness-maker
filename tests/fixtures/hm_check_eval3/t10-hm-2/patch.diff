new file mode 100644
index 0000000..8b58ccd
--- /dev/null
+++ b/timeparse/quota.py
@@ -0,0 +1,33 @@
+"""Client for the quota service."""
+
+from __future__ import annotations
+
+import json
+import os
+import urllib.request
+
+from timeparse.parse import parse_duration
+
+
+class MissingTokenError(RuntimeError):
+    """TIMEPARSE_TOKEN is unset or empty."""
+
+
+def fetch_quota(base_url: str, opener=urllib.request.urlopen) -> int:
+    """Return the remaining quota in seconds from `{base_url}/v1/quota`."""
+    token = os.environ.get("TIMEPARSE_TOKEN")
+    if not token:
+        raise MissingTokenError("TIMEPARSE_TOKEN is not set")
+    request = urllib.request.Request(
+        f"{base_url}/v1/quota",
+        headers={"Authorization": f"Bearer {token}"},
+        method="GET",
+    )
+    response = opener(request)
+    try:
+        body = response.read()
+    finally:
+        close = getattr(response, "close", None)
+        if close is not None:
+            close()
+    return parse_duration(json.loads(body)["remaining"])
