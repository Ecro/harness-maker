@@ -1,5 +1,7 @@
 """The CLI prints seconds and exits 2 on bad input."""
 
+import io
+
 import pytest
 from timeparse.cli import main
 
@@ -14,3 +16,105 @@ def test_invalid_exits_2(capsys: pytest.CaptureFixture[str]) -> None:
     captured = capsys.readouterr()
     assert captured.out == ""
     assert "nope" in captured.err
+
+
+class _Run:
+    def __init__(self, code: int, stdout: str, stderr: str) -> None:
+        self.code = code
+        self.stdout = stdout
+        self.stderr = stderr
+
+
+@pytest.fixture
+def run(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+):
+    def _run(argv: list[str], stdin: str = "") -> _Run:
+        monkeypatch.setattr("sys.stdin", io.StringIO(stdin))
+        code = main(argv)
+        captured = capsys.readouterr()
+        return _Run(code, captured.out, captured.err)
+
+    return _run
+
+
+def test_ac_001_sum_prints_only_total(run) -> None:
+    result = run(["--sum", "1h", "30m"])
+    assert result.stdout == "5400\n"
+    assert result.code == 0
+
+
+def test_ac_002_dash_reads_stdin_blanks_ignored(run) -> None:
+    result = run(["-", "--sum"], stdin="1m\n\n2m\n")
+    assert result.stdout == "180\n"
+    assert result.code == 0
+
+
+def test_ac_003_every_invalid_reported(run) -> None:
+    result = run(["1h", "x", "2q"])
+    assert result.stderr == (
+        "error: invalid duration: 'x'\nerror: invalid duration: '2q'\n"
+    )
+    assert result.stdout == ""
+    assert result.code == 2
+
+
+def test_ac_003_invalid_from_stdin_with_sum_prints_nothing(run) -> None:
+    result = run(["--sum", "1h", "-"], stdin="  bad \n1m\n")
+    assert result.stderr == "error: invalid duration: 'bad'\n"
+    assert result.stdout == ""
+    assert result.code == 2
+
+
+def test_ac_004_order_and_default_output(run) -> None:
+    result = run(["1h", "-", "1m"], stdin="  30s \n")
+    assert result.stdout == "3600\n30\n60\n"
+    assert result.code == 0
+
+
+def test_ac_004_argv_items_are_stripped(run) -> None:
+    result = run(["  1m ", "x "])
+    assert result.stderr == "error: invalid duration: 'x'\n"
+    assert run([" 1m "]).stdout == "60\n"
+
+
+def test_ac_003_empty_argv_item_is_invalid(run) -> None:
+    result = run(["", "1m"])
+    assert result.stderr == "error: invalid duration: ''\n"
+    assert result.stdout == ""
+    assert result.code == 2
+
+
+def test_ac_002_repeated_dash_reads_stdin_once(run) -> None:
+    assert run(["-", "5s", "-"], stdin="1m\n").stdout == "60\n5\n"
+
+
+def test_ac_002_empty_stdin(run) -> None:
+    assert run(["-", "--sum"], stdin="").stdout == "0\n"
+    assert run(["-"], stdin="\n  \n").stdout == ""
+
+
+def test_ac_001_sum_with_invalid_prints_nothing_on_stdout(run) -> None:
+    result = run(["--sum", "1m", "zz", "-"], stdin="q\n2m\n")
+    assert result.stdout == ""
+    assert result.stderr == (
+        "error: invalid duration: 'zz'\nerror: invalid duration: 'q'\n"
+    )
+    assert result.code == 2
+
+
+def test_help_names_program_and_sum_flag(capsys: pytest.CaptureFixture[str]) -> None:
+    with pytest.raises(SystemExit) as exc:
+        main(["--help"])
+    assert exc.value.code == 0
+    out = capsys.readouterr().out
+    assert out.startswith("usage: timeparse")
+    assert "--sum" in out
+    assert " print only the total seconds" in out
+    assert " durations such as 1h30m; '-' reads them from stdin" in out
+
+
+def test_no_durations_is_a_usage_error() -> None:
+    with pytest.raises(SystemExit) as exc:
+        main([])
+    assert exc.value.code == 2
