+
+
+@pytest.mark.parametrize(
+    ("seconds", "max_units", "text"),
+    [(86399, 2, "1d"), (86399, 1, "1d"), (3599, 1, "1h")],
+)
+def test_max_units_carry(seconds: int, max_units: int, text: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == text
+
+
+@pytest.mark.parametrize(
+    ("seconds", "max_units", "text"),
+    [(3601, 2, "1h"), (7205, 3, "2h5s"), (3661, 2, "1h1m")],
+)
+def test_max_units_zero_in_window(seconds: int, max_units: int, text: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == text
+
+
+@pytest.mark.parametrize(
+    ("seconds", "max_units", "text"), [(0, 1, "0s"), (5400, 4, "1h30m")]
+)
+def test_max_units_zero_and_wide(seconds: int, max_units: int, text: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == text
+
+
+@pytest.mark.parametrize("seconds", [-5, 0, 60, 5430])
+@pytest.mark.parametrize("max_units", [0, -1])
+def test_max_units_invalid(seconds: int, max_units: int) -> None:
+    with pytest.raises(ValueError):
+        format_duration(seconds, max_units=max_units)
+
+
+@pytest.mark.parametrize(
+    ("seconds", "max_units", "text"),
+    [
+        (90061, 1, "1d"),
+        (90061, 2, "1d1h"),
+        (90061, 4, "1d1h1m1s"),
+        (129600, 1, "2d"),
+        (150, 1, "3m"),
+    ],
+)
+def test_max_units_day_window_and_ties(seconds: int, max_units: int, text: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == text
+
+
+def test_max_units_matches_round_then_format() -> None:
+    sizes = [86400, 3600, 60, 1]
+    for s in range(200001):
+        first = next((i for i, size in enumerate(sizes) if s >= size), 3)
+        for k in range(1, 6):
+            step = sizes[min(first + k - 1, 3)]
+            rounded = (s + step // 2) // step * step
+            assert format_duration(s, max_units=k) == format_duration(rounded), (s, k)
diff --git a/timeparse/format.py b/timeparse/format.py
index 82b5cda..a33cad0 100644
--- a/timeparse/format.py
+++ b/timeparse/format.py
@@ -5,15 +5,27 @@ from __future__ import annotations
 from timeparse.parse import UNITS
 
 
-def format_duration(seconds: int) -> str:
+def format_duration(seconds: int, max_units: int | None = None) -> str:
     """Return the compact form of `seconds`, e.g. 5400 -> '1h30m', 0 -> '0s'.
 
     Zero units are left out. Negative input raises ValueError.
+
+    `max_units` keeps at most that many unit positions, counted from the largest
+    non-zero unit (a zero inside the window still uses a position). The rest is
+    rounded half-up into the smallest kept position, carrying upward:
+    5430 with max_units=1 -> '2h'. Values below 1 raise ValueError.
     """
+    if max_units is not None and max_units < 1:
+        raise ValueError("max_units must be at least 1")
     if seconds < 0:
         raise ValueError("negative duration")
     if seconds == 0:
         return "0s"
+    if max_units is not None:
+        sizes = list(UNITS.values())
+        first = next((i for i, size in enumerate(sizes) if seconds >= size), len(sizes) - 1)
+        step = sizes[min(first + max_units - 1, len(sizes) - 1)]
+        seconds = (seconds + step // 2) // step * step
     parts: list[str] = []
     remaining = seconds
     for unit, size in UNITS.items():
