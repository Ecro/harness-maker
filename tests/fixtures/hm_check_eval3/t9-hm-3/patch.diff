 import pytest
 from timeparse import format_duration, parse_duration
+from timeparse.format import UNIT_NAMES
+from timeparse.parse import UNITS
 
 
 @pytest.mark.parametrize(
@@ -19,3 +21,73 @@ def test_round_trip() -> None:
 def test_negative() -> None:
     with pytest.raises(ValueError):
         format_duration(-1)
+
+
+# --- long style (SPEC-format-duration-long-style) ---
+
+
+@pytest.fixture
+def restore_units():
+    """Tests edit UNITS in place; put the real table back afterwards."""
+    saved = dict(UNITS)
+    yield saved
+    UNITS.clear()
+    UNITS.update(saved)
+
+
+@pytest.mark.parametrize("seconds", [0, 45, 5400, 90061])
+def test_compact_default_unchanged(seconds: int) -> None:
+    assert format_duration(seconds, style="compact") == format_duration(seconds)
+    assert format_duration(5400, style="compact") == "1h30m"
+    assert format_duration(0, style="compact") == "0s"
+
+
+@pytest.mark.parametrize(
+    ("seconds", "text"),
+    [
+        (5400, "1 hour, 30 minutes"),
+        (90061, "1 day, 1 hour, 1 minute, 1 second"),
+        (45, "45 seconds"),
+        (1, "1 second"),
+        (7200, "2 hours"),
+        (172800, "2 days"),
+    ],
+)
+def test_long_singular_plural(seconds: int, text: str) -> None:
+    assert format_duration(seconds, style="long") == text
+
+
+def test_long_zero() -> None:
+    assert format_duration(0, style="long") == "0 seconds"
+
+
+@pytest.mark.parametrize("style", ["short", "", "LONG", "Compact", None])
+def test_invalid_style_and_negative_raise(style) -> None:
+    with pytest.raises(ValueError):
+        format_duration(1, style=style)
+    with pytest.raises(ValueError):
+        format_duration(0, style=style)
+
+
+@pytest.mark.parametrize("style", ["compact", "long"])
+def test_negative_raises_in_both_styles(style: str) -> None:
+    with pytest.raises(ValueError):
+        format_duration(-1, style=style)
+
+
+def test_unit_names_table_shape() -> None:
+    assert UNIT_NAMES["h"] == ("hour", "hours")
+    assert set(UNITS) <= set(UNIT_NAMES)
+
+
+def test_units_table_drives_both_styles(restore_units, monkeypatch) -> None:
+    monkeypatch.setitem(UNIT_NAMES, "w", ("week", "weeks"))
+    UNITS.clear()
+    UNITS.update({"w": 604800, **restore_units})
+    assert format_duration(694861) == "1w1d1h1m1s"
+    assert format_duration(694861, style="long") == "1 week, 1 day, 1 hour, 1 minute, 1 second"
+    assert format_duration(1209600, style="long") == "2 weeks"
+    UNITS.clear()
+    UNITS.update({k: v for k, v in restore_units.items() if k != "d"})
+    assert format_duration(90061) == "25h1m1s"
+    assert format_duration(90061, style="long") == "25 hours, 1 minute, 1 second"
