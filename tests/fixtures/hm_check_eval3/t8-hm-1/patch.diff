+    [
+        ("9223372036854775807s", MAX),
+        ("106751991167300d15h30m7s", MAX),
+        ("106751991167300d", 9223372036854720000),
+    ],
+)
+def test_s6_total_cap_accepted(text: str, seconds: int) -> None:
+    assert parse_duration(text) == seconds
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["9223372036854775808s", "106751991167301d", "106751991167300d16h", "106751991167300d15h30m8s"],
+)
+def test_s6_total_cap_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["", " \t\n", "\n"])
+def test_s7_empty_and_blank_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
