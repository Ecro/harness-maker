+
+
+@pytest.mark.parametrize("text", ["+1h", "-1h", "1h-30m", "1h+30m"])
+def test_s3_sign_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["١h", "１h", "1h٢m"])
+def test_s4_non_ascii_digits_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
