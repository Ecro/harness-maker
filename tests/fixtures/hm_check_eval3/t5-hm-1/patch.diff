@@ -0,0 +1,83 @@
+"""Token-bucket rate limiter configured with a `"N/DURATION"` rate string."""
+
+from __future__ import annotations
+
+import re
+import time
+from collections.abc import Callable
+
+from timeparse.parse import parse_duration
+
+_RATE = re.compile(r"([0-9]+)/(.+)", re.DOTALL)
+
+# Float slack, in tokens: a token due at t must be available at t despite rounding in the clock.
+_EPSILON = 1e-9
+
+
+def _positive_int(value: object, name: str) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+        raise ValueError(f"{name} must be a positive integer, got {value!r}")
+    return value
+
+
+class RateLimiter:
+    """Allow `N` actions per `DURATION`, with bursts of up to `burst` actions.
+
+    The bucket starts full and refills continuously. Not thread-safe.
+    """
+
+    def __init__(
+        self, rate: str, burst: int, clock: Callable[[], float] = time.monotonic
+    ) -> None:
+        match = _RATE.fullmatch(rate) if isinstance(rate, str) else None
+        if match is None:
+            raise ValueError(f"rate must look like 'N/DURATION', got {rate!r}")
+        count = int(match.group(1))
+        seconds = parse_duration(match.group(2))
+        if count < 1 or seconds < 1:
+            raise ValueError(f"rate must be positive, got {rate!r}")
+        self._burst = _positive_int(burst, "burst")
+        try:
+            self._per_second = count / seconds
+            self._tokens = float(self._burst)
+        except OverflowError:
+            raise ValueError(
+                f"rate or burst out of range: {rate!r}, {burst!r}"
+            ) from None
+        if (
+            self._per_second <= 0.0
+        ):  # the quotient underflowed: the bucket would never refill
+            raise ValueError(f"rate out of range: {rate!r}")
+        self._clock = clock
+        self._last = clock()
+
+    def _refill(self) -> None:
+        now = self._clock()
+        if now > self._last:
+            self._tokens = min(
+                float(self._burst), self._tokens + (now - self._last) * self._per_second
+            )
+            self._last = now
+
+    def _check(self, n: int) -> int:
+        n = _positive_int(n, "n")
+        if n > self._burst:
+            raise ValueError(f"n must be at most burst ({self._burst}), got {n}")
+        return n
+
+    def allow(self, n: int = 1) -> bool:
+        """Take `n` tokens and return True, or return False and take nothing."""
+        n = self._check(n)
+        self._refill()
+        if self._tokens + _EPSILON < n:
+            return False
+        self._tokens = max(0.0, self._tokens - n)
+        return True
+
+    def retry_after(self, n: int = 1) -> float:
+        """Seconds until `n` tokens are available; 0.0 if they are now. Takes nothing."""
+        n = self._check(n)
+        self._refill()
+        if self._tokens + _EPSILON >= n:
+            return 0.0
+        return (n - self._tokens) / self._per_second
