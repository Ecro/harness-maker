@@ -1,5 +1,7 @@
 """format_duration round-trips with parse_duration."""
 
+import random
+
 import pytest
 from timeparse import format_duration, parse_duration
 
@@ -19,3 +21,74 @@ def test_round_trip() -> None:
 def test_negative() -> None:
     with pytest.raises(ValueError):
         format_duration(-1)
+
+
+# --- max_units (SPEC-format-max-units) ---------------------------------------------------
+# Rows mirror AC-002's golden_table in specs/SPEC-format-max-units.machine.yaml; inlined so the
+# project's own pytest needs no harness_maker or yaml import.
+_GOLDEN = [
+    (5430, 1, "2h"),
+    (5399, 2, "1h30m"),
+    (3601, 2, "1h"),
+    (86399, 2, "1d"),
+    (90, 1, "2m"),
+    (89, 1, "1m"),
+    (0, 1, "0s"),
+    # SPEC S3 carry example and exact-half / just-under-half rows at each level
+    (3599, 1, "1h"),
+    (59, 1, "59s"),
+    (119, 1, "2m"),
+    (86399, 1, "1d"),
+    (86399, 3, "23h59m59s"),
+    (5400, 1, "2h"),
+    (5399, 1, "1h"),
+    # single-pass rounding: per-unit double rounding would give 2h here
+    (5370, 1, "1h"),
+    (129600, 1, "2d"),
+    (129599, 1, "1d"),
+    # window: a zero unit inside it uses a position; no carry needed when it fits
+    (3601, 3, "1h1s"),
+    (3601, 4, "1h1s"),
+    (90061, 2, "1d1h"),
+    (90061, 3, "1d1h1m"),
+    (3661, 2, "1h1m"),
+]
+
+
+def _frozen_default(seconds: int) -> str:
+    """Pre-change format_duration, frozen as the AC-001 differential reference."""
+    if seconds == 0:
+        return "0s"
+    parts = []
+    remaining = seconds
+    for unit, size in (("d", 86400), ("h", 3600), ("m", 60), ("s", 1)):
+        count, remaining = divmod(remaining, size)
+        if count:
+            parts.append(f"{count}{unit}")
+    return "".join(parts)
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 59, 60, 61, 3599, 3600, 5400, 86399, 90061, 999999])
+def test_ac_001_default_unchanged(seconds: int) -> None:
+    expected = _frozen_default(seconds)
+    assert format_duration(seconds) == expected
+    assert format_duration(seconds, max_units=None) == expected
+
+
+@pytest.mark.parametrize(("seconds", "max_units", "expected"), _GOLDEN)
+def test_ac_002_max_units_golden(seconds: int, max_units: int, expected: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == expected
+
+
+@pytest.mark.parametrize(("seconds", "max_units"), [(60, 0), (0, 0), (60, -1), (-1, 1)])
+def test_ac_003_max_units_invalid(seconds: int, max_units: int) -> None:
+    with pytest.raises(ValueError):
+        format_duration(seconds, max_units=max_units)
+
+
+def test_ac_004_large_max_units_is_identity() -> None:
+    rng = random.Random(1234)
+    samples = [0, 1, 59, 60, 3599, 3600, 86399, 86400] + [rng.randrange(10**7) for _ in range(300)]
+    for seconds in samples:
+        for max_units in (4, 5, 10):
+            assert format_duration(seconds, max_units=max_units) == format_duration(seconds)
diff --git a/timeparse/format.py b/timeparse/format.py
index 82b5cda..460021e 100644
--- a/timeparse/format.py
+++ b/timeparse/format.py
@@ -5,15 +5,25 @@ from __future__ import annotations
 from timeparse.parse import UNITS
 
 
-def format_duration(seconds: int) -> str:
+def format_duration(seconds: int, max_units: int | None = None) -> str:
     """Return the compact form of `seconds`, e.g. 5400 -> '1h30m', 0 -> '0s'.
 
     Zero units are left out. Negative input raises ValueError.
+
+    `max_units` keeps at most that many unit positions, counted from the largest non-zero unit
+    down; a zero unit inside the window still uses a position. What lies below the window is
+    rounded half-up into it, carrying upward (5430, 1 -> '2h'). Below 1 raises ValueError.
     """
+    if max_units is not None and max_units < 1:
+        raise ValueError("max_units must be at least 1")
     if seconds < 0:
         raise ValueError("negative duration")
     if seconds == 0:
         return "0s"
+    if max_units is not None:
+        sizes = [size for size in UNITS.values() if size <= seconds]
+        smallest = sizes[min(max_units, len(sizes)) - 1]
+        seconds = (seconds + smallest // 2) // smallest * smallest
     parts: list[str] = []
     remaining = seconds
     for unit, size in UNITS.items():
