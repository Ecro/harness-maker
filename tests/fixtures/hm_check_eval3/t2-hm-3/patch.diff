+"""save_durations / load_durations (SPEC-durations-store AC-001..AC-006)."""
+
+import json
+import os
+import random
+import stat
+from pathlib import Path
+
+import pytest
+from timeparse import parse_duration
+from timeparse.store import load_durations, save_durations
+
+GOLDEN = {"tea": "3m", "lunch": "1h"}
+
+
+def _listing(path: Path) -> list[str]:
+    return sorted(os.listdir(path.parent))
+
+
+def test_ac_001_roundtrip_golden(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    save_durations(path, GOLDEN)
+    assert json.loads(path.read_text()) == {"tea": 180, "lunch": 3600}
+    assert load_durations(path) == {"tea": 180, "lunch": 3600}
+
+
+def test_ac_001_roundtrip_property(tmp_path: Path) -> None:
+    rng = random.Random(1234)
+    units = ["d", "h", "m", "s"]
+    for case in range(50):
+        mapping = {}
+        for i in range(rng.randint(0, 5)):
+            parts = [f"{rng.randint(0, 99)}{u}" for u in units if rng.random() < 0.5]
+            mapping[f"name{case}-{i}"] = "".join(parts) or "1s"
+        path = tmp_path / f"p{case}.json"
+        save_durations(path, mapping)
+        assert load_durations(path) == {k: parse_duration(v) for k, v in mapping.items()}
+        assert json.loads(path.read_text()) == {k: parse_duration(v) for k, v in mapping.items()}
+
+
+def test_empty_mapping_writes_empty_object(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    save_durations(path, {})
+    assert json.loads(path.read_text()) == {}
+    assert load_durations(path) == {}
+
+
+@pytest.mark.parametrize("bad", [None, [("tea", "3m")], "tea=3m", 5, {1: "3m"}])
+@pytest.mark.parametrize("existing", [b'{"old": 1}', None])
+def test_ac_002_bad_mapping_raises_typeerror_and_keeps_file(
+    tmp_path: Path, bad: object, existing: bytes | None
+) -> None:
+    path = tmp_path / "d.json"
+    if existing is not None:
+        path.write_bytes(existing)
+    before = _listing(path)
+    with pytest.raises(TypeError):
+        save_durations(path, bad)  # type: ignore[arg-type]
+    assert _listing(path) == before
+    if existing is not None:
+        assert path.read_bytes() == existing
+
+
+def test_ac_003_invalid_value_names_key_and_keeps_file(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    path.write_bytes(b'{"old": 1}')
+    with pytest.raises(ValueError, match=r"\bzz_key\b"):
+        save_durations(path, {"a": "1h", "zz_key": "bogus"})
+    assert path.read_bytes() == b'{"old": 1}'
+    assert _listing(path) == ["d.json"]
+
+
+def test_ac_003_invalid_value_does_not_create_file(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    with pytest.raises(ValueError, match=r"\bzz_key\b"):
+        save_durations(path, {"zz_key": "bogus"})
+    assert _listing(path) == []
+
+
+def test_non_str_value_raises_valueerror_naming_key(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    with pytest.raises(ValueError, match=r"\bzz_key\b"):
+        save_durations(path, {"zz_key": 180})  # type: ignore[dict-item]
+    assert not path.exists()
+
+
+class _FailingWriter:
+    """File proxy whose write fails after the temp file already exists on disk."""
+
+    def __init__(self, real: object) -> None:
+        self._real = real
+
+    def __enter__(self) -> "_FailingWriter":
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        self._real.close()  # type: ignore[attr-defined]
+
+    def write(self, data: str) -> int:
+        raise OSError("injected")
+
+    def close(self) -> None:
+        self._real.close()  # type: ignore[attr-defined]
+
+
+@pytest.mark.parametrize("target", ["replace", "write"])
+@pytest.mark.parametrize("existing", [b'{"old": 1}', None])
+def test_ac_004_failure_keeps_original_and_cleans_temp(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, target: str, existing: bytes | None
+) -> None:
+    path = tmp_path / "d.json"
+    if existing is not None:
+        path.write_bytes(existing)
+    before = _listing(path)
+
+    if target == "replace":
+
+        def boom(*args: object, **kwargs: object) -> None:
+            raise OSError("injected")
+
+        monkeypatch.setattr("timeparse.store.os.replace", boom)
+    else:
+        real_fdopen = os.fdopen
+
+        def failing_fdopen(*args: object, **kwargs: object) -> _FailingWriter:
+            return _FailingWriter(real_fdopen(*args, **kwargs))  # type: ignore[arg-type]
+
+        monkeypatch.setattr("timeparse.store.os.fdopen", failing_fdopen)
+    with pytest.raises(OSError, match="injected"):
+        save_durations(path, GOLDEN)
+    assert _listing(path) == before
+    if existing is not None:
+        assert path.read_bytes() == existing
+
+
+def test_temp_file_is_a_sibling_of_target(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    path = tmp_path / "d.json"
+    seen: list[Path] = []
+
+    def spy(src: str, dst: object) -> None:
+        seen.append(Path(src))
+        raise OSError("injected")
+
+    monkeypatch.setattr("timeparse.store.os.replace", spy)
+    with pytest.raises(OSError):
+        save_durations(path, GOLDEN)
+    (temp,) = seen
+    assert temp.parent == tmp_path
+
+
+def test_ac_005_missing_file_returns_empty(tmp_path: Path) -> None:
+    assert load_durations(tmp_path / "missing.json") == {}
+
+
+def test_ac_006_str_and_path_equivalent(tmp_path: Path) -> None:
+    p = tmp_path / "a.json"
+    s = str(tmp_path / "b.json")
+    save_durations(p, {"tea": "3m"})
+    save_durations(s, {"tea": "3m"})
+    assert load_durations(str(p)) == load_durations(p) == {"tea": 180}
+    assert load_durations(s) == load_durations(Path(s)) == {"tea": 180}
+
+
+def test_corrupt_json_error_propagates(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    path.write_text("{not json")
+    with pytest.raises(json.JSONDecodeError):
+        load_durations(path)
+
+
+def test_mode_preserved_for_existing_and_umask_default_for_new(tmp_path: Path) -> None:
+    existing = tmp_path / "e.json"
+    existing.write_text("{}")
+    existing.chmod(0o640)
+    save_durations(existing, GOLDEN)
+    assert stat.S_IMODE(existing.stat().st_mode) == 0o640
+
+    old = os.umask(0o022)
+    try:
+        new = tmp_path / "n.json"
+        save_durations(new, GOLDEN)
+    finally:
+        os.umask(old)
+    assert stat.S_IMODE(new.stat().st_mode) == 0o644
+
+
+def test_interrupt_during_replace_cleans_temp_and_propagates(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    path = tmp_path / "d.json"
+    path.write_bytes(b'{"old": 1}')
+
+    def interrupt(*args: object, **kwargs: object) -> None:
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr("timeparse.store.os.replace", interrupt)
+    with pytest.raises(KeyboardInterrupt):
+        save_durations(path, GOLDEN)
+    assert _listing(path) == ["d.json"]
+    assert path.read_bytes() == b'{"old": 1}'
+
+
+def test_fdopen_failure_cleans_temp(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    path = tmp_path / "d.json"
+
+    def boom(*args: object, **kwargs: object) -> None:
+        raise OSError("injected")
+
+    monkeypatch.setattr("timeparse.store.os.fdopen", boom)
+    with pytest.raises(OSError, match="injected"):
+        save_durations(path, GOLDEN)
+    assert _listing(path) == []
+
+
+def test_save_does_not_change_process_umask(tmp_path: Path) -> None:
+    old = os.umask(0o027)
+    try:
+        save_durations(tmp_path / "n.json", GOLDEN)
+        assert os.umask(0o027) == 0o027
+    finally:
+        os.umask(old)
+
+
+def test_missing_parent_directory_is_not_created(tmp_path: Path) -> None:
+    path = tmp_path / "nope" / "d.json"
+    with pytest.raises(FileNotFoundError):
+        save_durations(path, GOLDEN)
+    assert not path.parent.exists()
+
+
+def test_symlink_target_is_written_through(tmp_path: Path) -> None:
+    real = tmp_path / "real.json"
+    real.write_text("{}")
+    link = tmp_path / "link.json"
+    link.symlink_to(real)
+    save_durations(link, {"tea": "3m"})
+    assert link.is_symlink()
+    assert json.loads(real.read_text()) == {"tea": 180}
+
+
+def test_temp_copy_of_existing_file_is_never_wider_than_owner_only(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    path = tmp_path / "d.json"
+    path.write_text("{}")
+    path.chmod(0o640)
+    seen: list[int] = []
+    real_fdopen = os.fdopen
+
+    def spy(fd: int, *args: object, **kwargs: object) -> object:
+        seen.append(stat.S_IMODE(os.fstat(fd).st_mode))
+        return real_fdopen(fd, *args, **kwargs)  # type: ignore[arg-type]
+
+    monkeypatch.setattr("timeparse.store.os.fdopen", spy)
+    old = os.umask(0o022)
+    try:
+        save_durations(path, GOLDEN)
+    finally:
+        os.umask(old)
+    assert seen == [0o600]
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
