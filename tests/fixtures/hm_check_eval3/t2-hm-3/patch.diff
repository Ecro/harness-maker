+"""Save and load named durations as a JSON file of name -> seconds."""
+
+from __future__ import annotations
+
+import json
+import os
+import stat
+import uuid
+from pathlib import Path
+
+from timeparse.parse import parse_duration
+
+
+def _validate(mapping: object) -> dict[str, int]:
+    if not isinstance(mapping, dict):
+        raise TypeError(f"mapping must be a dict, not {type(mapping).__name__}")
+    seconds: dict[str, int] = {}
+    for key, value in mapping.items():
+        if not isinstance(key, str):
+            raise TypeError(f"duration names must be str, not {type(key).__name__}")
+        if not isinstance(value, str):
+            raise ValueError(f"invalid duration for {key!r}: expected str, got {type(value).__name__}")
+        try:
+            seconds[key] = parse_duration(value)
+        except ValueError as exc:
+            raise ValueError(f"invalid duration for {key!r}: {exc}") from exc
+    return seconds
+
+
+def save_durations(path: str | Path, mapping: dict[str, str]) -> None:
+    """Write `mapping` (name -> duration string) to `path` as name -> seconds.
+
+    Nothing is written unless every value parses. The write goes to a temporary file in the
+    same directory and replaces `path`; on any failure `path` is unchanged and the temporary
+    file is removed. An existing file keeps its permissions; a new one gets the usual
+    umask-derived mode. A symlink at `path` is written through, not replaced.
+    """
+    seconds = _validate(mapping)
+    target = Path(os.path.realpath(path))
+    payload = json.dumps(seconds)
+    try:
+        mode = stat.S_IMODE(target.stat().st_mode)
+    except FileNotFoundError:
+        mode = None
+    tmp_name = str(target.parent / f".{target.name}.{uuid.uuid4().hex}.tmp")
+    # An existing file may be private: start the copy owner-only and widen it after the write.
+    fd = os.open(tmp_name, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600 if mode is not None else 0o666)
+    try:
+        try:
+            handle = os.fdopen(fd, "w", encoding="utf-8")
+        except BaseException:
+            os.close(fd)
+            raise
+        with handle:
+            handle.write(payload)
+        if mode is not None:
+            os.chmod(tmp_name, mode)
+        os.replace(tmp_name, target)
+    except BaseException:
+        try:
+            os.unlink(tmp_name)
+        except OSError:
+            pass
+        raise
+
+
+def load_durations(path: str | Path) -> dict[str, int]:
+    """Return the saved name -> seconds mapping; a missing file gives `{}`.
+
+    The JSON is returned as parsed; its shape is not validated.
+    """
+    try:
+        with open(path, encoding="utf-8") as handle:
+            loaded: dict[str, int] = json.load(handle)
+            return loaded
+    except FileNotFoundError:
+        return {}
