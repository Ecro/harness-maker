+# Rows mirror specs/SPEC-parse-iso-duration.machine.yaml (harness_maker is not a test dependency here).
+
+
+@pytest.mark.parametrize(
+    ("text", "seconds"),
+    [
+        ("P1D", 86400),
+        ("PT1H30M", 5400),
+        ("P1DT2H", 93600),
+        ("PT0S", 0),
+        ("PT90M", 5400),
+        (" P1DT1H1M1S ", 90061),
+        ("P0D", 0),
+        ("PT5S", 5),
+        ("P10DT10M", 864600),
+    ],
+)
+def test_ac_001_iso_valid(text: str, seconds: int) -> None:
+    from timeparse import parse_iso_duration
+
+    result = parse_iso_duration(text)
+    assert result == seconds
+    assert type(result) is int
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "", "P", "PT", "P1H", "PT1M1H", "pt1h", "p1d", "PT1.5S", "P1W", "P1M", "P1Y",
+        "-P1D", "PT-1S", "+P1D", "P1DT", "P1D T1H", "PT1H1H", "P1D1D", "PTH", "1D",
+        "PT1", "P1DT1D", "P١D", "PT1H\n30M", "P1,5D", "PT1S2", "PT1M1S1H",
+    ],
+)
+def test_ac_002_iso_invalid(text: str) -> None:
+    from timeparse import parse_iso_duration
+
+    with pytest.raises(ValueError):
+        parse_iso_duration(text)
+
+
+def test_ac_003_iso_exported_and_parse_duration_unchanged() -> None:
+    import timeparse
+
+    assert "parse_iso_duration" in timeparse.__all__
+    assert timeparse.parse_duration("1h30m") == 5400
