diff --git a/timeparse/parse.py b/timeparse/parse.py
index 9c1a7fb..31163d0 100644
--- a/timeparse/parse.py
+++ b/timeparse/parse.py
@@ -38,3 +38,24 @@ def parse_duration(text: str) -> int:
     if pos != len(cleaned):
         raise ValueError(f"invalid duration: {text!r}")
     return total
+
+
+_ISO = re.compile(
+    r"P(?:(?P<d>[0-9]+)D)?"
+    r"(?P<t>T(?:(?P<h>[0-9]+)H)?(?:(?P<m>[0-9]+)M)?(?:(?P<s>[0-9]+)S)?)?"
+)
+
+
+def parse_iso_duration(text: str) -> int:
+    """Return the number of seconds in an ISO-8601 duration, e.g. 'PT1H30M' -> 5400.
+
+    Accepts `P[nD][T[nH][nM][nS]]` with upper-case designators and non-negative ASCII integers;
+    surrounding whitespace is ignored. At least one component is required and `T` must be followed
+    by one. Anything else (years, months, weeks, fractions, signs, lower case) raises ValueError.
+    """
+    cleaned = text.strip()
+    match = _ISO.fullmatch(cleaned)
+    if match is None or cleaned == "P" or cleaned.endswith("T"):
+        raise ValueError(f"invalid ISO-8601 duration: {text!r}")
+    days, hours, minutes, seconds = (int(match[k] or 0) for k in "dhms")
+    return days * UNITS["d"] + hours * UNITS["h"] + minutes * UNITS["m"] + seconds * UNITS["s"]
