+"""save_durations / load_durations: SPEC-duration-store S1-S5.
+
+Golden rows are inlined from the machine SPEC (harness_maker is not a test dependency here).
+AC-003 and AC-004 are before/after invariants, checked over several inputs without Hypothesis.
+"""
+
+import json
+import os
+import stat
+import tempfile
+from pathlib import Path
+
+import pytest
+from timeparse.store import load_durations, save_durations
+
+ORIGINAL = b'{"keep": 7}'
+
+
+def _listing(directory: Path) -> list[str]:
+    return sorted(p.name for p in directory.iterdir())
+
+
+@pytest.fixture
+def target(tmp_path: Path) -> Path:
+    path = tmp_path / "durations.json"
+    path.write_bytes(ORIGINAL)
+    return path
+
+
+@pytest.mark.parametrize("as_str", [False, True])
+def test_s1_save_then_load(tmp_path: Path, as_str: bool) -> None:
+    path = tmp_path / "d.json"
+    arg = str(path) if as_str else path
+    save_durations(arg, {"tea": "3m", "lunch": "1h"})
+    assert json.loads(path.read_text(encoding="utf-8")) == {"tea": 180, "lunch": 3600}
+    assert load_durations(arg) == {"tea": 180, "lunch": 3600}
+    assert _listing(tmp_path) == ["d.json"]
+
+
+def test_s1_empty_mapping_and_types(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    save_durations(path, {})
+    assert json.loads(path.read_text(encoding="utf-8")) == {}
+    assert load_durations(path) == {}
+    save_durations(path, {"café": "1m30s"})
+    raw = json.loads(path.read_text(encoding="utf-8"))
+    assert raw == {"café": 90}
+    assert type(raw["café"]) is int
+
+
+def test_s1_load_reads_handwritten_file(tmp_path: Path) -> None:
+    path = tmp_path / "d.json"
+    path.write_text('{"tea": 180}', encoding="utf-8")
+    assert load_durations(path) == {"tea": 180}
+
+
+def test_s1_save_replaces_previous_contents(target: Path) -> None:
+    save_durations(target, {"tea": "3m"})
+    assert load_durations(target) == {"tea": 180}
+
+
+def test_s1_existing_file_mode_is_kept(target: Path) -> None:
+    target.chmod(0o644)
+    save_durations(target, {"tea": "3m"})
+    assert stat.S_IMODE(target.stat().st_mode) == 0o644
+
+
+@pytest.mark.parametrize(
+    "mapping",
+    [[("tea", "3m")], None, "tea", {"tea": 180}, {1: "3m"}, {"tea": None}, {"tea": "3m", "x": 5}, {"bad": "3x", "x": 5}],
+)
+def test_s2_type_errors(target: Path, mapping: object) -> None:
+    with pytest.raises(TypeError):
+        save_durations(target, mapping)  # type: ignore[arg-type]
+    assert target.read_bytes() == ORIGINAL
+    assert _listing(target.parent) == ["durations.json"]
+
+
+@pytest.mark.parametrize(
+    ("mapping", "bad_key"),
+    [
+        ({"tea": "3m", "zzbad": "3x"}, "zzbad"),
+        ({"zzbad": ""}, "zzbad"),
+        ({"a": "1h", "zzbad": "30m1h", "b": "2d"}, "zzbad"),
+        ({"first_bad": "x", "second_bad": "y"}, "first_bad"),
+    ],
+)
+def test_s3_invalid_value_names_key_and_keeps_file(
+    target: Path, mapping: dict[str, str], bad_key: str
+) -> None:
+    with pytest.raises(ValueError, match=bad_key):
+        save_durations(target, mapping)
+    assert target.read_bytes() == ORIGINAL
+    assert _listing(target.parent) == ["durations.json"]
+
+
+def test_s3_invalid_value_does_not_create_file(tmp_path: Path) -> None:
+    path = tmp_path / "new.json"
+    with pytest.raises(ValueError, match="bad"):
+        save_durations(path, {"bad": "nope"})
+    assert _listing(tmp_path) == []
+
+
+def test_s4_failure_in_replace_keeps_original_and_no_temp(
+    target: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def boom(*args: object, **kwargs: object) -> None:
+        raise OSError("replace failed")
+
+    monkeypatch.setattr(os, "replace", boom)
+    with pytest.raises(OSError, match="replace failed"):
+        save_durations(target, {"tea": "3m"})
+    assert target.read_bytes() == ORIGINAL
+    assert _listing(target.parent) == ["durations.json"]
+
+
+def test_s4_failure_in_write_keeps_original_and_no_temp(
+    target: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The temp file exists (and its fd is dead) when the write fails, so cleanup must run."""
+    real_mkstemp = tempfile.mkstemp
+    seen: list[list[str]] = []
+
+    def broken_fd_mkstemp(*args: object, **kwargs: object) -> tuple[int, str]:
+        fd, name = real_mkstemp(*args, **kwargs)
+        os.close(fd)
+        seen.append(_listing(target.parent))
+        return fd, name
+
+    monkeypatch.setattr(tempfile, "mkstemp", broken_fd_mkstemp)
+    with pytest.raises(OSError):
+        save_durations(target, {"tea": "3m"})
+    assert len(seen) == 1 and len(seen[0]) == 2  # target + temp existed before the failure
+    assert target.read_bytes() == ORIGINAL
+    assert _listing(target.parent) == ["durations.json"]
+
+
+def test_s4_failure_on_new_target_leaves_nothing(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def boom(*args: object, **kwargs: object) -> None:
+        raise OSError("replace failed")
+
+    monkeypatch.setattr(os, "replace", boom)
+    with pytest.raises(OSError):
+        save_durations(tmp_path / "new.json", {"tea": "3m"})
+    assert _listing(tmp_path) == []
+
+
+def test_s5_missing_file_returns_empty(tmp_path: Path) -> None:
+    path = tmp_path / "missing.json"
+    assert load_durations(path) == {}
+    assert load_durations(str(path)) == {}
+    assert _listing(tmp_path) == []
+
+
+@pytest.mark.parametrize("content", ["{not json", "[1, 2]", '{"tea": "3m"}', '{"tea": 1.5}', '{"tea": true}'])
+def test_load_rejects_bad_content(tmp_path: Path, content: str) -> None:
+    path = tmp_path / "d.json"
+    path.write_text(content, encoding="utf-8")
+    with pytest.raises(ValueError):
+        load_durations(path)
