+"""schedule keeps accepting zero durations, whatever parse_duration does.
+
+Passes before the change on purpose: a regression guard that goes red if the zero rejection
+leaks in; the RED sibling test_parse.py::test_zero_total_rejected forces that rejection to exist.
+"""
+
+from timeparse.schedule import normalize, total
+
+
+def test_other_functions_accept_zero() -> None:
+    assert normalize("0m") == "0s"
+    assert total([]) == "0s"
+    assert total(["0s"]) == "0s"
+    assert total(["0s", "1h"]) == "1h"
