--- a/tests/test_format.py
+++ b/tests/test_format.py
@@ -19,3 +19,99 @@ def test_round_trip() -> None:
 def test_negative() -> None:
     with pytest.raises(ValueError):
         format_duration(-1)
+
+
+@pytest.fixture
+def patched_units(monkeypatch: pytest.MonkeyPatch):
+    """Mutate the shared UNITS / UNIT_NAMES dicts in place; restored on teardown."""
+    from timeparse.format import UNIT_NAMES
+    from timeparse.parse import UNITS
+
+    monkeypatch.setattr("timeparse.parse.UNITS", UNITS)  # registers restore point
+    saved_units, saved_names = dict(UNITS), dict(UNIT_NAMES)
+
+    def apply(units: dict, names: dict | None = None) -> None:
+        UNITS.clear()
+        UNITS.update(units)
+        if names is not None:
+            UNIT_NAMES.update(names)
+
+    yield apply
+    UNITS.clear()
+    UNITS.update(saved_units)
+    UNIT_NAMES.clear()
+    UNIT_NAMES.update(saved_names)
+
+
+@pytest.mark.parametrize(
+    ("seconds", "text"),
+    [
+        (1, "1 second"),
+        (45, "45 seconds"),
+        (60, "1 minute"),
+        (5400, "1 hour, 30 minutes"),
+        (7200, "2 hours"),
+        (86400, "1 day"),
+        (90061, "1 day, 1 hour, 1 minute, 1 second"),
+        (172800 + 2, "2 days, 2 seconds"),
+    ],
+)
+def test_s1_long_style_examples(seconds: int, text: str) -> None:
+    assert format_duration(seconds, style="long") == text
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 59, 60, 5400, 86399, 90061, 10**7])
+def test_s2_compact_default_unchanged(seconds: int) -> None:
+    assert format_duration(seconds, style="compact") == format_duration(seconds)
+
+
+def test_s2_compact_examples() -> None:
+    assert format_duration(5400, style="compact") == "1h30m"
+    assert format_duration(0, style="compact") == "0s"
+
+
+def test_s3_long_zero() -> None:
+    assert format_duration(0, style="long") == "0 seconds"
+
+
+@pytest.mark.parametrize("style", ["bogus", "", "LONG", None])
+def test_s3_invalid_style(style) -> None:
+    with pytest.raises(ValueError):
+        format_duration(60, style=style)
+
+
+@pytest.mark.parametrize("style", ["compact", "long"])
+def test_s3_negative(style: str) -> None:
+    with pytest.raises(ValueError):
+        format_duration(-1, style=style)
+
+
+def test_s3_style_is_keyword_only() -> None:
+    with pytest.raises(TypeError):
+        format_duration(60, "long")  # type: ignore[misc]
+
+
+def test_s4_added_unit_follows_units(patched_units) -> None:
+    from timeparse.parse import UNITS
+
+    patched_units({"w": 604800, **UNITS}, {"w": ("week", "weeks")})
+    assert format_duration(694861) == "1w1d1h1m1s"
+    assert (
+        format_duration(694861, style="long")
+        == "1 week, 1 day, 1 hour, 1 minute, 1 second"
+    )
+
+
+def test_s4_removed_unit_follows_units(patched_units) -> None:
+    from timeparse.parse import UNITS
+
+    patched_units({k: v for k, v in UNITS.items() if k != "d"})
+    assert format_duration(90061) == "25h1m1s"
+    assert format_duration(90061, style="long") == "25 hours, 1 minute, 1 second"
+
+
+def test_compact_does_not_need_unit_names(patched_units) -> None:
+    from timeparse.parse import UNITS
+
+    patched_units({"w": 604800, **UNITS})
+    assert format_duration(694861) == "1w1d1h1m1s"
