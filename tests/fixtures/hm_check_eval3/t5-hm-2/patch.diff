+"""RateLimiter token bucket, per specs/SPEC-ratelimit.md.
+
+AC-006 is a metamorphic property; it uses a seeded random.Random rather than Hypothesis
+because the project has no Hypothesis dependency.
+"""
+
+import random
+import time
+
+import pytest
+from timeparse.ratelimit import RateLimiter
+
+
+class Clock:
+    def __init__(self, now: float = 0.0) -> None:
+        self.now = now
+
+    def __call__(self) -> float:
+        return self.now
+
+
+def make(rate: str, burst: int, start: float = 0.0) -> tuple[RateLimiter, Clock]:
+    clock = Clock(start)
+    return RateLimiter(rate, burst, clock=clock), clock
+
+
+@pytest.mark.parametrize("rate", ["10/1s", "5/1m", "3/1h30m"])
+def test_ac001_valid_rates(rate: str) -> None:
+    make(rate, 1)
+
+
+@pytest.mark.parametrize(
+    "rate",
+    [10, None, "10", "10s", "10/1s/2", "/1s", "0/1s", "-1/1s", "+5/1s", "1.5/1s",
+     "x/1s", "10/", "10/xyz", "10/0s", "10/1h30"],
+)
+def test_ac001_construction_validation(rate: object) -> None:
+    with pytest.raises(ValueError):
+        RateLimiter(rate, 1)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("burst", [0, -1, 1.5, True, "3", None])
+def test_ac001_invalid_burst(burst: object) -> None:
+    with pytest.raises(ValueError):
+        RateLimiter("10/1s", burst)  # type: ignore[arg-type]
+
+
+def test_ac001_invalid_clock() -> None:
+    with pytest.raises(ValueError):
+        RateLimiter("10/1s", 1, clock=5)  # type: ignore[arg-type]
+
+
+def test_ac001_default_clock_is_monotonic() -> None:
+    limiter = RateLimiter("10/1s", 1)
+    assert limiter.allow() is True
+    assert time.monotonic() > 0
+
+
+def test_ac002_starts_full_and_drains() -> None:
+    limiter, _ = make("1/1h", 3)
+    assert [limiter.allow() for _ in range(4)] == [True, True, True, False]
+    limiter, _ = make("1/1h", 3)
+    assert limiter.allow(3) is True
+    assert limiter.allow() is False
+
+
+def test_ac003_exactly_when_due() -> None:
+    limiter, clock = make("10/1s", 1)
+    for step in range(11):
+        clock.now = step / 10 if step in (0, 10) else float(f"0.{step}")
+        assert limiter.allow() is True, clock.now
+    limiter, clock = make("10/1s", 1)
+    assert limiter.allow() is True
+    clock.now = 0.05
+    assert limiter.allow() is False
+
+
+def test_ac003_accumulated_float_steps() -> None:
+    limiter, clock = make("10/1s", 1)
+    t = 0.0
+    for _ in range(11):
+        clock.now = t
+        assert limiter.allow() is True, t
+        t += 0.1
+
+
+def test_ac004_refill_and_cap() -> None:
+    limiter, clock = make("3/1h30m", 3)
+    assert limiter.allow(3) is True
+    clock.now = 1799.0
+    assert limiter.allow() is False
+    clock.now = 1800.0
+    assert limiter.allow() is True
+    clock.now = 10**9
+    assert [limiter.allow() for _ in range(4)] == [True, True, True, False]
+
+
+def test_ac004_backwards_clock_adds_nothing() -> None:
+    limiter, clock = make("1/10s", 1, start=10.0)
+    assert limiter.allow() is True
+    clock.now = 5.0
+    assert limiter.allow() is False
+    clock.now = 10.0
+    assert limiter.allow() is False
+    assert limiter.retry_after() == pytest.approx(10.0, abs=1e-9)
+
+
+def test_ac005_retry_after_values() -> None:
+    limiter, clock = make("10/1s", 1)
+    assert limiter.retry_after() == 0.0
+    assert limiter.allow() is True
+    assert limiter.retry_after() == pytest.approx(0.1, abs=1e-9)
+    clock.now = 0.05
+    assert limiter.retry_after() == pytest.approx(0.05, abs=1e-9)
+    clock.now = 0.1
+    assert limiter.retry_after() == 0.0
+    assert isinstance(limiter.retry_after(), float)
+
+    limiter, _ = make("3/1h30m", 3)
+    assert limiter.allow(3) is True
+    assert limiter.retry_after(1) == pytest.approx(1800.0, abs=1e-9)
+    assert limiter.retry_after(3) == pytest.approx(5400.0, abs=1e-9)
+
+
+def test_ac006_no_side_effects() -> None:
+    rng = random.Random(20261015)
+    for _ in range(200):
+        burst = rng.randint(1, 5)
+        rate = f"{rng.randint(1, 9)}/{rng.randint(1, 5)}s"
+        a, ca = make(rate, burst)
+        b, cb = make(rate, burst)
+        now = 0.0
+        for _ in range(40):
+            now += rng.choice([0.0, 0.01, 0.1, 0.37, 1.0, 2.5])
+            ca.now = cb.now = now
+            n = rng.randint(1, burst)
+            if rng.random() < 0.5:
+                # extra calls only A receives: any retry_after, and a probe allow only
+                # when it is denied (a successful allow legitimately takes tokens).
+                a.retry_after(rng.randint(1, burst))
+                m = rng.randint(1, burst)
+                if a.retry_after(m) > 0.0:
+                    assert a.allow(m) is False
+            assert (a.retry_after(n) == 0.0) == (b.retry_after(n) == 0.0)
+            ready = a.retry_after(n) == 0.0
+            assert a.allow(n) is b.allow(n) is ready
+
+
+def test_ac007_n_validation() -> None:
+    limiter, _ = make("10/1s", 3)
+    for bad in [0, -1, 4, 1.5, "1", True]:
+        with pytest.raises(ValueError):
+            limiter.allow(bad)  # type: ignore[arg-type]
+        with pytest.raises(ValueError):
+            limiter.retry_after(bad)  # type: ignore[arg-type]
+    for good in (1, 2, 3):
+        limiter, _ = make("10/1s", 3)
+        assert limiter.retry_after(good) == 0.0
+        assert limiter.allow(good) is True
+    limiter, _ = make("10/1s", 3)
+    with pytest.raises(ValueError):
+        limiter.allow(4)
+    assert limiter.allow(3) is True
diff --git a/timeparse/ratelimit.py b/timeparse/ratelimit.py
new file mode 100644
index 0000000..125b423
--- /dev/null
+++ b/timeparse/ratelimit.py
@@ -0,0 +1,75 @@
+"""Token-bucket rate limiter."""
+
+import time
+from collections.abc import Callable
+
+from timeparse.parse import parse_duration
+
+# A token counts as available when within this many tokens of the amount asked for, so a
+# token that is due exactly (0.3 - 0.2 is 0.09999999999999998 in floats) is not refused.
+_TOLERANCE = 1e-9
+
+
+def _parse_rate(rate: str) -> float:
+    """Return tokens per second for an "N/DURATION" string."""
+    if not isinstance(rate, str):
+        raise ValueError(f"rate must be a string, got {type(rate).__name__}")
+    parts = rate.split("/")
+    if len(parts) != 2:
+        raise ValueError(f"rate must look like 'N/DURATION': {rate!r}")
+    count_text = parts[0].strip()
+    if not (count_text.isascii() and count_text.isdigit()) or int(count_text) <= 0:
+        raise ValueError(f"rate count must be a positive integer: {rate!r}")
+    seconds = parse_duration(parts[1])
+    if seconds <= 0:
+        raise ValueError(f"rate duration must be positive: {rate!r}")
+    return int(count_text) / seconds
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+class RateLimiter:
+    """Allow `rate` ("N/DURATION") events sustained, with bursts up to `burst`."""
+
+    def __init__(
+        self, rate: str, burst: int, clock: Callable[[], float] = time.monotonic
+    ) -> None:
+        self._per_second = _parse_rate(rate)
+        if not _is_int(burst) or burst <= 0:
+            raise ValueError(f"burst must be a positive integer: {burst!r}")
+        if not callable(clock):
+            raise ValueError("clock must be callable")
+        self._burst = burst
+        self._clock = clock
+        self._tokens = float(burst)
+        self._last = clock()
+
+    def _check(self, n: int) -> None:
+        if not _is_int(n) or not 1 <= n <= self._burst:
+            raise ValueError(f"n must be an integer from 1 to {self._burst}: {n!r}")
+
+    def _refill(self) -> None:
+        now = self._clock()
+        if now > self._last:  # a clock that steps backwards adds nothing
+            gained = (now - self._last) * self._per_second
+            self._tokens = min(float(self._burst), self._tokens + gained)
+            self._last = now
+
+    def allow(self, n: int = 1) -> bool:
+        """Take `n` tokens and return True if they are available, else take nothing."""
+        self._check(n)
+        self._refill()
+        if self._tokens < n - _TOLERANCE:
+            return False
+        self._tokens = max(0.0, self._tokens - n)
+        return True
+
+    def retry_after(self, n: int = 1) -> float:
+        """Seconds until `n` tokens are available (0.0 now). Takes no tokens."""
+        self._check(n)
+        self._refill()
+        if self._tokens >= n - _TOLERANCE:
+            return 0.0
+        return (n - self._tokens) / self._per_second
