+"""parse_duration input contract (SPEC-parse-duration-contract, AC-001..AC-006).
+
+Rows are the goldens from the SPEC's machine.yaml, written inline so the project needs no
+harness_maker test dependency.
+"""
+
+import pytest
+from timeparse import parse_duration
+
+MAX = 2**63 - 1
+
+
+@pytest.mark.parametrize(("text", "seconds"), [(" 1h\t", 3600), ("\n45s\n", 45)])
+def test_s1_ascii_whitespace_ignored(text: str, seconds: int) -> None:
+    assert parse_duration(text) == seconds
+
+
+@pytest.mark.parametrize(
+    "text", ["\u00a01h", "1h\u00a0", "\u20031h", "1h\u2003", "1h\r", "\r1h"]
+)
+def test_s2_other_whitespace_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["+1h", "-1h", "1h-30m"])
+def test_s3_signs_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["\u0661h", "\uff11h"])
+def test_s4_ascii_digits_only(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+def test_s4_leading_zeros_allowed() -> None:
+    assert parse_duration("007s") == 7
+
+
+@pytest.mark.parametrize("text", ["9223372036854775807s", "106751991167300d15h30m7s"])
+def test_s5_int64_cap_accepts_max(text: str) -> None:
+    assert parse_duration(text) == MAX
+
+
+def test_s5_int64_cap_accepts_just_under() -> None:
+    assert parse_duration("106751991167300d15h") == 106751991167300 * 86400 + 15 * 3600
+
+
+@pytest.mark.parametrize(
+    "text", ["9223372036854775808s", "106751991167301d", "106751991167300d16h"]
+)
+def test_s5_int64_cap_rejects_over(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["", " \t\n"])
+def test_s6_empty_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
