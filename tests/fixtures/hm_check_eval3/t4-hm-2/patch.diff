@@ -1,5 +1,8 @@
 """The CLI prints seconds and exits 2 on bad input."""
 
+import io
+import sys
+
 import pytest
 from timeparse.cli import main
 
@@ -14,3 +17,58 @@ def test_invalid_exits_2(capsys: pytest.CaptureFixture[str]) -> None:
     captured = capsys.readouterr()
     assert captured.out == ""
     assert "nope" in captured.err
+
+
+def _run(
+    monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str],
+    argv: list[str],
+    stdin: str = "",
+) -> tuple[int, str, str]:
+    monkeypatch.setattr(sys, "stdin", io.StringIO(stdin))
+    code = main(argv)
+    captured = capsys.readouterr()
+    return code, captured.out, captured.err
+
+
+def test_ac_001_sum_of_arguments(monkeypatch, capsys) -> None:
+    assert _run(monkeypatch, capsys, ["--sum", "1h", "30m"]) == (0, "5400\n", "")
+
+
+def test_ac_002_stdin_mixed_with_args(monkeypatch, capsys) -> None:
+    assert _run(monkeypatch, capsys, ["-", "--sum"], "1m\n\n2m\n") == (0, "180\n", "")
+    assert _run(monkeypatch, capsys, ["-", "30s"], "1m\n2m\n") == (
+        0,
+        "60\n120\n30\n",
+        "",
+    )
+    assert _run(monkeypatch, capsys, ["--sum", "-"], "") == (0, "0\n", "")
+    assert _run(monkeypatch, capsys, ["--sum", "-", "-"], "1m\n") == (0, "60\n", "")
+    assert _run(monkeypatch, capsys, ["30s", "-"], "  1m \n\n2m\n") == (
+        0,
+        "30\n60\n120\n",
+        "",
+    )
+
+
+def test_ac_003_reports_every_invalid(monkeypatch, capsys) -> None:
+    err = "error: invalid duration: 'x'\nerror: invalid duration: '2q'\n"
+    assert _run(monkeypatch, capsys, ["1h", "x", "2q"]) == (2, "", err)
+    assert _run(monkeypatch, capsys, [" 2q "]) == (
+        2,
+        "",
+        "error: invalid duration: '2q'\n",
+    )
+
+
+def test_ac_004_invalid_from_stdin_and_sum(monkeypatch, capsys) -> None:
+    err = "error: invalid duration: 'bad'\nerror: invalid duration: '2q'\n"
+    assert _run(monkeypatch, capsys, ["--sum", "-", "2q"], " bad \n1m\n") == (
+        2,
+        "",
+        err,
+    )
+
+
+def test_ac_005_plain_output_unchanged(monkeypatch, capsys) -> None:
+    assert _run(monkeypatch, capsys, ["1h", "30s"]) == (0, "3600\n30\n", "")
