@@ -10,22 +10,48 @@ from timeparse.parse import parse_duration
 
 def _parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="timeparse", description=__doc__)
-    parser.add_argument("durations", nargs="+", help="durations such as 1h30m")
+    parser.add_argument(
+        "durations",
+        nargs="+",
+        help="durations such as 1h30m; '-' reads them from stdin",
+    )
+    parser.add_argument(
+        "--sum", action="store_true", help="print only the total seconds"
+    )
     return parser
 
 
+def _inputs(durations: list[str]) -> list[str]:
+    """Strip each input, expanding '-' into the non-blank lines of stdin (read once)."""
+    texts: list[str] = []
+    for item in durations:
+        if item.strip() == "-":
+            texts.extend(
+                line.strip() for line in sys.stdin.read().splitlines() if line.strip()
+            )
+        else:
+            texts.append(item.strip())
+    return texts
+
+
 def main(argv: list[str] | None = None) -> int:
-    """Print one line of seconds per argument; exit 2 on the first invalid one."""
+    """Print seconds per duration (or their total with --sum); exit 2 listing every invalid one."""
     args = _parser().parse_args(argv)
     results: list[int] = []
-    for text in args.durations:
+    invalid = False
+    for text in _inputs(args.durations):
         try:
             results.append(parse_duration(text))
         except ValueError:
             print(f"error: invalid duration: {text!r}", file=sys.stderr)
-            return 2
-    for value in results:
-        print(value)
+            invalid = True
+    if invalid:
+        return 2
+    if args.sum:
+        print(sum(results))
+    else:
+        for value in results:
+            print(value)
     return 0
 
 
