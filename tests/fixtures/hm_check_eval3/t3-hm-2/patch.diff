index 0000000..912003f
--- /dev/null
+++ b/tests/test_parse_iso.py
@@ -0,0 +1,52 @@
+"""parse_iso_duration on the day-and-time ISO-8601 subset (SPEC-parse-iso-duration)."""
+
+import random
+
+import pytest
+import timeparse
+from timeparse import parse_duration, parse_iso_duration
+
+
+@pytest.mark.parametrize(
+    ("text", "seconds"),
+    [
+        ("P1D", 86400),
+        ("PT1H30M", 5400),
+        ("P1DT2H", 93600),
+        ("PT0S", 0),
+        ("PT90M", 5400),
+        ("  PT1S\n", 1),
+        ("PT007S", 7),
+    ],
+)
+def test_ac_001_iso_valid_examples(text: str, seconds: int) -> None:
+    result = parse_iso_duration(text)
+    assert result == seconds
+    assert type(result) is int
+
+
+def test_ac_002_iso_component_sum_property() -> None:
+    rng = random.Random(1234)
+    for _ in range(300):
+        d, h, m, s = (rng.randint(0, 10**4) for _ in range(4))
+        assert parse_iso_duration(f"P{d}DT{h}H{m}M{s}S") == 86400 * d + 3600 * h + 60 * m + s
+        assert parse_iso_duration(f"P{d}D") == 86400 * d
+        assert parse_iso_duration(f"PT{h}H{s}S") == 3600 * h + s
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "P", "PT", "P1H", "PT1M1H", "pt1h", "PT1.5S", "P1Y", "P1W", "P1M", "-PT1S", "PT-1S",
+        "P1DT", "P1D1D", "PT1H1H", "", "   ", "PT1 H", "PT١S", "PT1", "1D", "P1DT1D",
+    ],
+)
+def test_ac_003_iso_invalid_raises(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_iso_duration(text)
+
+
+def test_ac_004_iso_exported() -> None:
+    assert "parse_iso_duration" in timeparse.__all__
+    assert callable(timeparse.parse_iso_duration)
+    assert parse_duration("1h30m") == 5400
