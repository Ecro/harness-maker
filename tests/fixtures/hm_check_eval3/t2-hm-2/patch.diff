+"""store.py: atomic save/load of named durations (SPEC-timeparse-store)."""
+
+import json
+import os
+import random
+import stat
+import tempfile
+from pathlib import Path
+
+import pytest
+from timeparse import parse_duration
+from timeparse.store import load_durations, save_durations
+
+_GOLDEN = {"tea": "3m", "lunch": "1h"}
+_GOLDEN_SECONDS = {"tea": 180, "lunch": 3600}
+
+
+def _seed_file(tmp_path: Path) -> tuple[Path, bytes]:
+    path = tmp_path / "store.json"
+    path.write_bytes(b'{"old": 1}')
+    return path, path.read_bytes()
+
+
+@pytest.mark.parametrize("kind", [str, Path])
+def test_ac_001_save_load_golden(tmp_path: Path, kind: type) -> None:
+    path = kind(tmp_path / "store.json")
+    save_durations(path, _GOLDEN)
+    assert json.loads(Path(path).read_text()) == _GOLDEN_SECONDS
+    assert load_durations(path) == _GOLDEN_SECONDS
+
+
+@pytest.mark.parametrize("bad", [[("tea", "3m")], ("tea",), None, "tea", {1: "3m"}])
+def test_ac_002_rejects_bad_mapping(tmp_path: Path, bad: object) -> None:
+    path, original = _seed_file(tmp_path)
+    with pytest.raises(TypeError):
+        save_durations(path, bad)  # type: ignore[arg-type]
+    assert path.read_bytes() == original
+    assert os.listdir(tmp_path) == [path.name]
+
+
+def test_ac_002_rejects_non_dict_mapping_type(tmp_path: Path) -> None:
+    from types import MappingProxyType
+
+    path, original = _seed_file(tmp_path)
+    with pytest.raises(TypeError):
+        save_durations(path, MappingProxyType({"tea": "3m"}))  # type: ignore[arg-type]
+    assert path.read_bytes() == original
+    assert os.listdir(tmp_path) == [path.name]
+
+
+@pytest.mark.parametrize("value", ["10x", "", "1h1h", 180, None])
+def test_ac_003_invalid_value_names_key(tmp_path: Path, value: object) -> None:
+    path, original = _seed_file(tmp_path)
+    with pytest.raises(ValueError, match="bad"):
+        save_durations(path, {"tea": "3m", "bad": value})  # type: ignore[dict-item]
+    assert path.read_bytes() == original
+    assert os.listdir(tmp_path) == [path.name]
+
+
+@pytest.mark.parametrize("value", ["10x", 180])
+def test_ac_003_message_contains_exact_key(tmp_path: Path, value: object) -> None:
+    with pytest.raises(ValueError) as info:
+        save_durations(tmp_path / "store.json", {"tea": "3m", "zq_key": value})  # type: ignore[dict-item]
+    assert "zq_key" in str(info.value)
+    assert "tea" not in str(info.value)
+
+
+def test_ac_003_invalid_value_leaves_absent_file_absent(tmp_path: Path) -> None:
+    path = tmp_path / "store.json"
+    with pytest.raises(ValueError, match="bad"):
+        save_durations(path, {"bad": "10x"})
+    assert os.listdir(tmp_path) == []
+
+
+def test_ac_004_replace_failure_is_atomic(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    path, original = _seed_file(tmp_path)
+
+    def boom(*_args: object, **_kw: object) -> None:
+        raise OSError("replace failed")
+
+    monkeypatch.setattr(os, "replace", boom)
+    with pytest.raises(OSError, match="replace failed"):
+        save_durations(path, _GOLDEN)
+    assert path.read_bytes() == original
+    assert os.listdir(tmp_path) == [path.name]
+
+
+def test_ac_004_write_failure_is_atomic(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Fail at the write itself: the temp file exists but its descriptor is read-only."""
+    path, original = _seed_file(tmp_path)
+    created: list[str] = []
+    real_mkstemp = tempfile.mkstemp
+
+    def readonly_mkstemp(*args: object, **kwargs: object) -> tuple[int, str]:
+        fd, name = real_mkstemp(*args, **kwargs)
+        os.close(fd)
+        created.append(name)
+        return os.open(name, os.O_RDONLY), name
+
+    monkeypatch.setattr(tempfile, "mkstemp", readonly_mkstemp)
+    with pytest.raises(OSError):
+        save_durations(path, _GOLDEN)
+    assert created, (
+        "save_durations must write through a temp file made by tempfile.mkstemp"
+    )
+    assert not any(os.path.exists(name) for name in created)
+    assert path.read_bytes() == original
+    assert os.listdir(tmp_path) == [path.name]
+
+
+def test_ac_004_missing_parent_creates_nothing(tmp_path: Path) -> None:
+    with pytest.raises(FileNotFoundError):
+        save_durations(tmp_path / "nope" / "store.json", _GOLDEN)
+    assert os.listdir(tmp_path) == []
+
+
+def test_ac_005_load_missing_returns_empty(tmp_path: Path) -> None:
+    assert load_durations(tmp_path / "missing.json") == {}
+
+
+@pytest.mark.parametrize(
+    "content", ["{", "[]", '"x"', '{"tea": "3m"}', '{"tea": true}', '{"tea": 1.5}']
+)
+def test_load_invalid_content_raises_value_error(tmp_path: Path, content: str) -> None:
+    path = tmp_path / "store.json"
+    path.write_text(content)
+    with pytest.raises(ValueError):
+        load_durations(path)
+
+
+def test_save_empty_mapping_writes_empty_object(tmp_path: Path) -> None:
+    path = tmp_path / "store.json"
+    save_durations(path, {})
+    assert path.read_text() == "{}"
+    assert load_durations(path) == {}
+
+
+def test_save_overwrites_and_preserves_existing_mode(tmp_path: Path) -> None:
+    path, _ = _seed_file(tmp_path)
+    path.chmod(0o640)
+    save_durations(path, _GOLDEN)
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
+    assert load_durations(path) == _GOLDEN_SECONDS
+
+
+def test_save_new_file_mode_follows_umask(tmp_path: Path) -> None:
+    old = os.umask(0o027)
+    try:
+        path = tmp_path / "store.json"
+        save_durations(path, _GOLDEN)
+    finally:
+        os.umask(old)
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+def test_ac_006_roundtrip_property(tmp_path: Path) -> None:
+    rng = random.Random(20261015)
+    units = [("d", 86400), ("h", 3600), ("m", 60), ("s", 1)]
+    path = tmp_path / "store.json"
+    for _ in range(50):
+        mapping = {}
+        for i in range(rng.randint(0, 6)):
+            chosen = [u for u, _ in units if rng.random() < 0.5] or ["s"]
+            mapping[f"name{i}"] = "".join(f"{rng.randint(0, 99)}{u}" for u in chosen)
+        save_durations(path, mapping)
+        assert load_durations(path) == {
+            k: parse_duration(v) for k, v in mapping.items()
+        }
+
+
+def test_save_new_file_mode_with_zero_umask_is_0666(tmp_path: Path) -> None:
+    old = os.umask(0)
+    try:
+        path = tmp_path / "store.json"
+        save_durations(path, _GOLDEN)
+    finally:
+        os.umask(old)
+    assert stat.S_IMODE(path.stat().st_mode) == 0o666
+
+
+@pytest.mark.parametrize(
+    ("bad", "type_name"), [([("tea", "3m")], "list"), (None, "NoneType")]
+)
+def test_ac_002_message_names_received_type(
+    tmp_path: Path, bad: object, type_name: str
+) -> None:
+    with pytest.raises(TypeError, match=type_name):
+        save_durations(tmp_path / "store.json", bad)  # type: ignore[arg-type]
+
+
+def test_ac_002_non_str_key_message_names_type(tmp_path: Path) -> None:
+    with pytest.raises(TypeError, match="int"):
+        save_durations(tmp_path / "store.json", {1: "3m"})  # type: ignore[dict-item]
+
+
+def test_ac_003_non_str_value_message_names_type(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="int"):
+        save_durations(tmp_path / "store.json", {"tea": 180})  # type: ignore[dict-item]
+
+
+@pytest.mark.parametrize(
+    ("content", "expected"),
+    [("[]", "list"), ('"x"', "str"), ('{"tea": 1.5}', "tea"), ('{"tea": 1.5}', "1.5")],
+)
+def test_load_invalid_content_message_is_specific(
+    tmp_path: Path, content: str, expected: str
+) -> None:
+    path = tmp_path / "store.json"
+    path.write_text(content)
+    with pytest.raises(ValueError, match=expected):
+        load_durations(path)
+
+
+def test_ac_004_temp_file_is_in_target_directory(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    seen: list[Path] = []
+    real_replace = os.replace
+
+    def spy(src: str, dst: str) -> None:
+        seen.append(Path(src).parent)
+        real_replace(src, dst)
+
+    monkeypatch.setattr(os, "replace", spy)
+    path = tmp_path / "store.json"
+    save_durations(path, _GOLDEN)
+    assert seen == [tmp_path]
+
+
+def test_messages_are_exact(tmp_path: Path) -> None:
+    path = tmp_path / "store.json"
+    with pytest.raises(TypeError) as info:
+        save_durations(path, [])  # type: ignore[arg-type]
+    assert str(info.value) == "mapping must be a dict, got list"
+    with pytest.raises(TypeError) as info:
+        save_durations(path, {1: "3m"})  # type: ignore[dict-item]
+    assert str(info.value) == "duration names must be str, got int"
+    with pytest.raises(ValueError) as info:
+        save_durations(path, {"tea": 180})  # type: ignore[dict-item]
+    assert str(info.value) == "invalid duration for 'tea': expected str, got int"
+    with pytest.raises(ValueError) as info:
+        save_durations(path, {"bad": "10x"})
+    assert str(info.value).startswith("invalid duration for 'bad': ")
+    assert str(info.value).endswith(" in '10x'")
+
+
+def test_load_messages_are_exact(tmp_path: Path) -> None:
+    path = tmp_path / "store.json"
+    path.write_text("[]")
+    with pytest.raises(ValueError) as info:
+        load_durations(path)
+    assert str(info.value) == f"{path}: expected a JSON object, got list"
+    path.write_text('{"tea": 1.5}')
+    with pytest.raises(ValueError) as info:
+        load_durations(path)
+    assert str(info.value) == f"{path}: duration for 'tea' is not an int: 1.5"
+
+
+def test_ac_004_temp_file_name_is_dotted_tmp_of_target(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    seen: list[str] = []
+    real_replace = os.replace
+
+    def spy(src: str, dst: str) -> None:
+        seen.append(Path(src).name)
+        real_replace(src, dst)
+
+    monkeypatch.setattr(os, "replace", spy)
+    save_durations(tmp_path / "store.json", _GOLDEN)
+    assert len(seen) == 1
+    assert seen[0].startswith(".store.json.")
+    assert seen[0].endswith(".tmp")
+
+
+def test_save_never_touches_process_umask(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def forbidden(_mask: int) -> int:
+        raise AssertionError("os.umask must not be called")
+
+    monkeypatch.setattr(os, "umask", forbidden)
+    path = tmp_path / "store.json"
+    save_durations(path, _GOLDEN)
+    assert load_durations(path) == _GOLDEN_SECONDS
+    assert os.listdir(tmp_path) == [path.name]
