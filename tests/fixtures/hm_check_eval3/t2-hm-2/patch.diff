+++ b/timeparse/store.py
@@ -0,0 +1,88 @@
+"""Save and load named durations as a JSON file of name -> seconds."""
+
+from __future__ import annotations
+
+import json
+import os
+import stat
+import tempfile
+from pathlib import Path
+
+from timeparse.parse import parse_duration
+
+
+def _file_mode(path: Path, probe: str) -> int:
+    """Mode for the new file: the existing target's, else what the umask allows.
+
+    A new file's mode is found by creating a throwaway file at `probe` and reading back the
+    mode the kernel gave it, so the process-wide umask is never touched.
+    """
+    try:
+        return stat.S_IMODE(path.stat().st_mode)
+    except FileNotFoundError:
+        pass
+    fd = os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
+    try:
+        return stat.S_IMODE(os.fstat(fd).st_mode)
+    finally:
+        os.close(fd)
+        os.unlink(probe)
+
+
+def save_durations(path: str | Path, mapping: dict[str, str]) -> None:
+    """Write `mapping` (name -> duration string) to `path` as JSON seconds, atomically.
+
+    Every value is parsed before the file is touched. A non-dict mapping or a non-str key
+    raises TypeError; an invalid value raises ValueError naming its key. The data goes to a
+    temp file in the target's directory and is then swapped in, so a failure at any point
+    leaves the original file as it was and no temp file behind.
+    """
+    if not isinstance(mapping, dict):
+        raise TypeError(f"mapping must be a dict, got {type(mapping).__name__}")
+    seconds: dict[str, int] = {}
+    for key, text in mapping.items():
+        if not isinstance(key, str):
+            raise TypeError(f"duration names must be str, got {type(key).__name__}")
+        if not isinstance(text, str):
+            raise ValueError(
+                f"invalid duration for {key!r}: expected str, got {type(text).__name__}"
+            )
+        try:
+            seconds[key] = parse_duration(text)
+        except ValueError as exc:
+            raise ValueError(f"invalid duration for {key!r}: {exc}") from exc
+
+    target = Path(path)
+    fd, tmp_name = tempfile.mkstemp(
+        dir=target.parent, prefix=f".{target.name}.", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(seconds, handle)
+        os.chmod(tmp_name, _file_mode(target, tmp_name + ".mode"))
+        os.replace(tmp_name, target)
+    except BaseException:
+        try:
+            os.unlink(tmp_name)
+        except FileNotFoundError:
+            pass
+        raise
+
+
+def load_durations(path: str | Path) -> dict[str, int]:
+    """Return the name -> seconds mapping stored at `path`; a missing file gives {}.
+
+    Invalid JSON, a top-level value that is not an object, or a value that is not an int
+    raises ValueError.
+    """
+    try:
+        with open(path, encoding="utf-8") as handle:
+            data = json.load(handle)
+    except FileNotFoundError:
+        return {}
+    if not isinstance(data, dict):
+        raise ValueError(f"{path}: expected a JSON object, got {type(data).__name__}")
+    for key, value in data.items():
+        if not isinstance(value, int) or isinstance(value, bool):
+            raise ValueError(f"{path}: duration for {key!r} is not an int: {value!r}")
+    return data
