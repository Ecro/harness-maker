+++ b/tests/test_format.py
@@ -19,3 +19,24 @@ def test_round_trip() -> None:
 def test_negative() -> None:
     with pytest.raises(ValueError):
         format_duration(-1)
+
+
+@pytest.mark.parametrize(
+    ("seconds", "text"),
+    [
+        (604800, "1w"),
+        (1209600, "2w"),
+        (694861, "1w1d1h1m1s"),
+        (604799, "6d23h59m59s"),
+    ],
+)
+def test_ac_001_format_weeks(seconds: int, text: str) -> None:
+    assert format_duration(seconds) == text
+
+
+_BOUNDARIES = (0, 1, 59, 60, 3599, 3600, 86399, 86400, 604799, 604800, 604801, 1209600, 10000000)
+
+
+def test_ac_004_round_trip_weeks() -> None:
+    for seconds in (*_BOUNDARIES, *range(0, 10000001, 7919)):
+        assert parse_duration(format_duration(seconds)) == seconds
