@@ -1,5 +1,7 @@
 """The CLI prints seconds and exits 2 on bad input."""
 
+import io
+
 import pytest
 from timeparse.cli import main
 
@@ -14,3 +16,87 @@ def test_invalid_exits_2(capsys: pytest.CaptureFixture[str]) -> None:
     captured = capsys.readouterr()
     assert captured.out == ""
     assert "nope" in captured.err
+
+
+def _stdin(monkeypatch: pytest.MonkeyPatch, text: str) -> None:
+    monkeypatch.setattr("sys.stdin", io.StringIO(text))
+
+
+def test_sum_of_arguments(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["--sum", "1h", "30m"]) == 0
+    assert capsys.readouterr().out == "5400\n"
+
+
+def test_stdin_mixed_with_sum(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _stdin(monkeypatch, "1m\n\n2m\n")
+    assert main(["-", "--sum"]) == 0
+    assert capsys.readouterr().out == "180\n"
+
+
+def test_stdin_keeps_order(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _stdin(monkeypatch, "  1m \n\n2m\n")
+    assert main(["30s", "-"]) == 0
+    assert capsys.readouterr().out == "30\n60\n120\n"
+
+
+def test_all_invalid_reported(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["1h", "x", "2q"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == "error: invalid duration: 'x'\nerror: invalid duration: '2q'\n"
+
+
+def test_invalid_stdin_line_stripped_even_with_sum(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _stdin(monkeypatch, "  zz  \n1m\n")
+    assert main(["--sum", "-", "y"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == "error: invalid duration: 'zz'\nerror: invalid duration: 'y'\n"
+
+
+def test_default_output_unchanged(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["1h", "30m"]) == 0
+    assert capsys.readouterr().out == "3600\n1800\n"
+
+
+@pytest.mark.parametrize("inputs", [["1s"], ["1d", "2h", "3m4s"], ["0s", "59m", "1h30m", "2d"]])
+def test_sum_equals_sum_of_lines(
+    inputs: list[str], capsys: pytest.CaptureFixture[str]
+) -> None:
+    main(inputs)
+    lines = [int(x) for x in capsys.readouterr().out.split()]
+    main(["--sum", *inputs])
+    assert int(capsys.readouterr().out) == sum(lines)
+
+
+def test_stdin_read_once_for_repeated_dash(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    class Counting(io.StringIO):
+        reads = 0
+
+        def read(self, size: int | None = -1) -> str:
+            Counting.reads += 1
+            return super().read(size)
+
+    monkeypatch.setattr("sys.stdin", Counting("1m\n"))
+    assert main(["-", "-", "--sum"]) == 0
+    assert capsys.readouterr().out == "60\n"
+    assert Counting.reads == 1
+
+
+def test_help_mentions_sum_and_stdin(capsys: pytest.CaptureFixture[str]) -> None:
+    with pytest.raises(SystemExit) as exc:
+        main(["--help"])
+    assert exc.value.code == 0
+    out = capsys.readouterr().out
+    assert "usage: timeparse" in out
+    text = " ".join(out.split())
+    assert "durations such as 1h30m; '-' reads lines from stdin options:" in text
+    assert text.endswith("--sum print only the total seconds")
diff --git a/timeparse/cli.py b/timeparse/cli.py
index e92dd69..9918cc7 100644
--- a/timeparse/cli.py
+++ b/timeparse/cli.py
@@ -10,22 +10,43 @@ from timeparse.parse import parse_duration
 
 def _parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="timeparse", description=__doc__)
-    parser.add_argument("durations", nargs="+", help="durations such as 1h30m")
+    parser.add_argument(
+        "durations", nargs="+", help="durations such as 1h30m; '-' reads lines from stdin"
+    )
+    parser.add_argument("--sum", action="store_true", help="print only the total seconds")
     return parser
 
 
+def _inputs(durations: list[str]) -> list[str]:
+    """Expand '-' into the non-blank stdin lines, keeping order; strip every input."""
+    texts: list[str] = []
+    for index, item in enumerate(durations):
+        if item != "-":
+            texts.append(item.strip())
+        elif durations.index("-") == index:  # a repeated '-' finds stdin already consumed
+            texts.extend(line.strip() for line in sys.stdin.read().splitlines() if line.strip())
+    return texts
+
+
 def main(argv: list[str] | None = None) -> int:
-    """Print one line of seconds per argument; exit 2 on the first invalid one."""
+    """Print seconds per duration (or their total with --sum); exit 2 listing every invalid one."""
     args = _parser().parse_args(argv)
     results: list[int] = []
-    for text in args.durations:
+    invalid: list[str] = []
+    for text in _inputs(args.durations):
         try:
             results.append(parse_duration(text))
         except ValueError:
+            invalid.append(text)
+    if invalid:
+        for text in invalid:
             print(f"error: invalid duration: {text!r}", file=sys.stderr)
-            return 2
-    for value in results:
-        print(value)
+        return 2
+    if args.sum:
+        print(sum(results))
+    else:
+        for value in results:
+            print(value)
     return 0
 
 
