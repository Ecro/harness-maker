--- a/tests/test_format.py
+++ b/tests/test_format.py
@@ -1,5 +1,7 @@
 """format_duration round-trips with parse_duration."""
 
+import re
+
 import pytest
 from timeparse import format_duration, parse_duration
 
@@ -19,3 +21,68 @@ def test_round_trip() -> None:
 def test_negative() -> None:
     with pytest.raises(ValueError):
         format_duration(-1)
+
+
+# --- max_units (SPEC-format-duration-max-units) ---
+
+# Mirrors AC-002's golden_table in specs/SPEC-format-duration-max-units.machine.yaml. Inlined
+# because the project test env does not carry harness_maker; keep the two in step.
+_ROWS = [
+    (5430, 1, "2h"), (5399, 2, "1h30m"), (3601, 2, "1h"), (86399, 2, "1d"),
+    (90, 1, "2m"), (89, 1, "1m"), (0, 1, "0s"),
+    (150, 1, "3m"), (210, 1, "4m"), (5400, 1, "2h"), (129600, 1, "2d"),
+]
+
+
+def test_ac_001_default_unchanged() -> None:
+    assert format_duration(5400) == "1h30m"
+    assert format_duration(5400, max_units=None) == "1h30m"
+    assert format_duration(0) == "0s"
+    assert format_duration(90061, max_units=None) == "1d1h1m1s"
+
+
+@pytest.mark.parametrize(("seconds", "max_units", "expected"), _ROWS)
+def test_ac_002_golden_rounding(seconds: int, max_units: int, expected: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == expected
+
+
+def test_ac_003_token_cap_and_error_bound() -> None:
+    sizes = {"d": 86400, "h": 3600, "m": 60, "s": 1}
+    for seconds in list(range(0, 4000)) + list(range(80000, 180000, 997)):
+        for k in range(1, 6):
+            out = format_duration(seconds, max_units=k)
+            assert len(re.findall(r"\d+[dhms]", out)) <= k
+            if seconds == 0:
+                continue
+            full = format_duration(seconds)
+            positions = {"d": 4, "h": 3, "m": 2, "s": 1}[re.match(r"\d+([dhms])", full).group(1)]
+            unit = "smhd"[positions - min(k, positions)]  # smallest kept unit
+            if positions <= k:
+                assert out == full
+            # Round-trip bound: rounding moves the value by at most half the smallest kept unit.
+            assert abs(parse_duration(out) - seconds) <= sizes[unit] // 2
+
+
+@pytest.mark.parametrize("bad", [0, -1, -5])
+def test_ac_004_below_one_raises(bad: int) -> None:
+    with pytest.raises(ValueError):
+        format_duration(60, max_units=bad)
+
+
+def test_ac_004_validated_before_zero_shortcut() -> None:
+    with pytest.raises(ValueError):
+        format_duration(0, max_units=0)
+    with pytest.raises(ValueError):
+        format_duration(-1, max_units=2)
+
+
+# Extra discrimination rows (review T1/T2), hand-derived from the SPEC window and half-up rules.
+@pytest.mark.parametrize(
+    ("seconds", "max_units", "expected"),
+    [
+        (86460, 2, "1d"), (86401, 3, "1d"), (86461, 3, "1d1m"), (3601, 3, "1h1s"),
+        (9000, 1, "3h"), (216000, 1, "3d"), (5399, 1, "1h"), (129599, 1, "1d"),
+    ],
+)
+def test_ac_002_zero_position_and_tie_parity(seconds: int, max_units: int, expected: str) -> None:
+    assert format_duration(seconds, max_units=max_units) == expected
diff --git a/timeparse/format.py b/timeparse/format.py
index 82b5cda..1c1a6d7 100644
--- a/timeparse/format.py
+++ b/timeparse/format.py
@@ -5,15 +5,29 @@ from __future__ import annotations
 from timeparse.parse import UNITS
 
 
-def format_duration(seconds: int) -> str:
+def format_duration(seconds: int, max_units: int | None = None) -> str:
     """Return the compact form of `seconds`, e.g. 5400 -> '1h30m', 0 -> '0s'.
 
     Zero units are left out. Negative input raises ValueError.
+
+    With `max_units`, keep at most that many unit positions counted down from the
+    largest non-zero unit (a zero position still uses one up), rounding half-up
+    into the smallest kept position: 5430 with max_units=1 -> '2h'.
+    `max_units` below 1 raises ValueError.
     """
     if seconds < 0:
         raise ValueError("negative duration")
+    if max_units is not None and max_units < 1:
+        raise ValueError("max_units must be at least 1")
     if seconds == 0:
         return "0s"
+    if max_units is not None:
+        sizes = list(UNITS.values())
+        top = next(i for i, size in enumerate(sizes) if seconds >= size)
+        last = top + max_units - 1
+        if last < len(sizes) - 1:
+            size = sizes[last]
+            seconds = (seconds + size // 2) // size * size
     parts: list[str] = []
     remaining = seconds
     for unit, size in UNITS.items():
