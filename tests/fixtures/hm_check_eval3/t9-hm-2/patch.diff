diff --git a/tests/test_format.py b/tests/test_format.py
index 01cab9d..16ea411 100644
--- a/tests/test_format.py
+++ b/tests/test_format.py
@@ -19,3 +19,70 @@ def test_round_trip() -> None:
 def test_negative() -> None:
     with pytest.raises(ValueError):
         format_duration(-1)
+
+
+# --- long style (SPEC-format-duration-long-style) ---------------------------------------
+from timeparse import format as _format_mod  # noqa: E402
+from timeparse.parse import UNITS  # noqa: E402
+
+
+@pytest.fixture
+def units_table():
+    """Edit the shared UNITS / UNIT_NAMES tables in place, restoring them afterwards."""
+    units_before, names_before = dict(UNITS), dict(_format_mod.UNIT_NAMES)
+    yield UNITS, _format_mod.UNIT_NAMES
+    UNITS.clear()
+    UNITS.update(units_before)
+    _format_mod.UNIT_NAMES.clear()
+    _format_mod.UNIT_NAMES.update(names_before)
+
+
+@pytest.mark.parametrize("style", [{}, {"style": "compact"}])
+def test_ac_001_compact_default_unchanged(style: dict) -> None:
+    assert format_duration(5400, **style) == "1h30m"
+    assert format_duration(0, **style) == "0s"
+    assert format_duration(90061, **style) == "1d1h1m1s"
+
+
+def test_ac_002_long_style_examples() -> None:
+    assert format_duration(5400, style="long") == "1 hour, 30 minutes"
+    assert format_duration(90061, style="long") == "1 day, 1 hour, 1 minute, 1 second"
+    assert format_duration(2, style="long") == "2 seconds"
+
+
+def test_ac_003_long_zero() -> None:
+    assert format_duration(0, style="long") == "0 seconds"
+
+
+@pytest.mark.parametrize("seconds", [0, 5])
+@pytest.mark.parametrize("style", ["bogus", "Long", "", None])
+def test_ac_004_invalid_style_raises(seconds: int, style) -> None:
+    with pytest.raises(ValueError):
+        format_duration(seconds, style=style)
+
+
+@pytest.mark.parametrize("style", ["compact", "long"])
+def test_ac_004_negative_raises(style: str) -> None:
+    with pytest.raises(ValueError):
+        format_duration(-1, style=style)
+
+
+def test_ac_005_week_added(units_table) -> None:
+    units, names = units_table
+    rest = dict(units)
+    units.clear()
+    units["w"] = 604800
+    units.update(rest)
+    names["w"] = ("week", "weeks")
+    assert format_duration(694861) == "1w1d1h1m1s"
+    assert (
+        format_duration(694861, style="long")
+        == "1 week, 1 day, 1 hour, 1 minute, 1 second"
+    )
+
+
+def test_ac_005_day_removed(units_table) -> None:
+    units, _ = units_table
+    del units["d"]
+    assert format_duration(90061) == "25h1m1s"
+    assert format_duration(90061, style="long") == "25 hours, 1 minute, 1 second"
diff --git a/timeparse/format.py b/timeparse/format.py
index 82b5cda..5664f23 100644
--- a/timeparse/format.py
+++ b/timeparse/format.py
@@ -1,23 +1,40 @@
-"""Turn a number of seconds back into a compact duration string."""
+"""Turn a number of seconds back into a compact or long duration string."""
 
 from __future__ import annotations
 
 from timeparse.parse import UNITS
 
+# Singular and plural name of each unit letter in UNITS, used by the "long" style.
+UNIT_NAMES: dict[str, tuple[str, str]] = {
+    "d": ("day", "days"),
+    "h": ("hour", "hours"),
+    "m": ("minute", "minutes"),
+    "s": ("second", "seconds"),
+}
 
-def format_duration(seconds: int) -> str:
-    """Return the compact form of `seconds`, e.g. 5400 -> '1h30m', 0 -> '0s'.
+_STYLES = ("compact", "long")
 
-    Zero units are left out. Negative input raises ValueError.
+
+def format_duration(seconds: int, style: str = "compact") -> str:
+    """Return `seconds` as text, e.g. 5400 -> '1h30m' (compact) or '1 hour, 30 minutes' (long).
+
+    Zero units are left out; zero itself is '0s' (compact) or '0 seconds' (long). Negative input
+    or an unknown `style` raises ValueError.
     """
+    if style not in _STYLES:
+        raise ValueError(f"unknown style: {style!r}")
     if seconds < 0:
         raise ValueError("negative duration")
     if seconds == 0:
-        return "0s"
+        return "0s" if style == "compact" else "0 seconds"
     parts: list[str] = []
     remaining = seconds
     for unit, size in UNITS.items():
         count, remaining = divmod(remaining, size)
         if count:
-            parts.append(f"{count}{unit}")
-    return "".join(parts)
+            if style == "compact":
+                parts.append(f"{count}{unit}")
+            else:
+                singular, plural = UNIT_NAMES[unit]
+                parts.append(f"{count} {singular if count == 1 else plural}")
+    return "".join(parts) if style == "compact" else ", ".join(parts)
