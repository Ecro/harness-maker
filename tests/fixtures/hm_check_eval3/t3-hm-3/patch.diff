@@ -0,0 +1,64 @@
+"""parse_iso_duration on the SPEC iso-duration grammar (AC-001..AC-003)."""
+
+import pytest
+import timeparse
+from timeparse import parse_duration, parse_iso_duration
+
+# Golden values mirror specs/SPEC-iso-duration.machine.yaml (AC-001 / AC-002); inlined so the
+# suite needs only pytest.
+_VALID = [
+    ("P1D", 86400),
+    ("PT1H30M", 5400),
+    ("P1DT2H", 93600),
+    ("PT0S", 0),
+    ("PT90M", 5400),
+    (" P1DT1H1M1S ", 90061),
+]
+_INVALID = ["P", "PT", "P1H", "PT1M1H", "pt1h", "PT1.5S", "P1W", "P1M", "-PT1S", "P1DT",
+            "PT1S\nx", ""]
+
+
+@pytest.mark.parametrize(("text", "seconds"), _VALID)
+def test_ac_001_valid_iso_durations(text: str, seconds: int) -> None:
+    result = parse_iso_duration(text)
+    assert result == seconds
+    assert type(result) is int
+
+
+@pytest.mark.parametrize("text", _INVALID)
+def test_ac_002_invalid_iso_durations_raise(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_iso_duration(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "seconds"),
+    [
+        ("PT1S\n", 1),
+        (" PT1S", 1),
+        ("PT1S ", 1),
+        ("\tPT5S\t", 5),
+        ("P10D", 864000),
+        ("PT90S", 90),
+        ("PT007S", 7),
+    ],
+)
+def test_ac_001_whitespace_and_multi_digit(text: str, seconds: int) -> None:
+    result = parse_iso_duration(text)
+    assert result == seconds
+    assert type(result) is int
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["PT١S", "P١D", "P1 D", "PT1 H", "P1D1D", "PT1S1M", "P1DT1D", "P1Y", "+PT1S", "PT-1S",
+     "PT1h", "PT1H1H", "PT1,5S"],
+)
+def test_ac_002_extra_edges(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_iso_duration(text)
+
+
+def test_ac_003_exported_and_parse_duration_unchanged() -> None:
+    assert "parse_iso_duration" in timeparse.__all__
+    assert parse_duration("1h30m") == 5400
