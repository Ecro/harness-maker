diff --git a/timeparse/parse.py b/timeparse/parse.py
index 9c1a7fb..81146bc 100644
--- a/timeparse/parse.py
+++ b/timeparse/parse.py
@@ -38,3 +38,22 @@ def parse_duration(text: str) -> int:
     if pos != len(cleaned):
         raise ValueError(f"invalid duration: {text!r}")
     return total
+
+
+# [0-9], not \d: reject Unicode digits; callers use fullmatch, not $: reject a trailing newline.
+_ISO = re.compile(r"P(?:([0-9]+)D)?(?:T(?:([0-9]+)H)?(?:([0-9]+)M)?(?:([0-9]+)S)?)?")
+
+
+def parse_iso_duration(text: str) -> int:
+    """Return the number of seconds in an ISO-8601 duration, e.g. 'PT1H30M' -> 5400.
+
+    Supports `P[nD][T[nH][nM][nS]]` with upper-case designators and non-negative integers;
+    surrounding whitespace is ignored. At least one component is required and `T` must be
+    followed by one of H, M, S. Anything else raises ValueError.
+    """
+    cleaned = text.strip()
+    match = _ISO.fullmatch(cleaned)
+    if match is None or cleaned in ("P", "") or cleaned.endswith("T"):
+        raise ValueError(f"invalid ISO-8601 duration: {text!r}")
+    days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+    return days * 86400 + hours * 3600 + minutes * 60 + seconds
