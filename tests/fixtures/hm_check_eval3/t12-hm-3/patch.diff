@@ -14,8 +14,17 @@ def parse_duration(text: str) -> int:
     """Return the number of seconds in `text`, e.g. '1h30m' -> 5400.
 
     Surrounding whitespace is ignored and units are case-insensitive. Each unit may appear
-    once, largest first. Anything else raises ValueError.
+    once, largest first. A zero total is rejected, since it is always a mistake in a timeout.
+    Anything else invalid raises ValueError.
     """
+    total = parse_duration_allow_zero(text)
+    if total == 0:
+        raise ValueError(f"zero duration: {text!r}")
