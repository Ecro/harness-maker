diff --git a/tests/test_quota.py b/tests/test_quota.py
new file mode 100644
index 0000000..4822457
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,69 @@
+"""fetch_quota against fake openers (SPEC quota-client); no network, placeholder token only."""
+
+import io
+import json
+
+import pytest
+from timeparse.quota import MissingTokenError, fetch_quota
+
+BASE = "https://q.example"
+
+
+class FakeOpener:
+    def __init__(self, body: str = '{"remaining": "1h30m"}') -> None:
+        self.body = body
+        self.requests: list = []
+
+    def __call__(self, request):
+        self.requests.append(request)
+        return io.BytesIO(self.body.encode())
+
+    @property
+    def calls(self) -> int:
+        return len(self.requests)
+
+
+def test_s1_request_shape(monkeypatch):
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "dummy")
+    opener = FakeOpener()
+    fetch_quota(BASE, opener)
+    assert opener.calls == 1
+    request = opener.requests[0]
+    assert request.get_method() == "GET"
+    assert request.full_url == "https://q.example/v1/quota"
+    assert request.get_header("Authorization") == "Bearer dummy"
+
+
+@pytest.mark.parametrize(
+    ("remaining", "seconds"), [("1h30m", 5400), ("45s", 45), ("2m", 120)]
+)
+def test_s2_remaining_parsed_to_seconds(monkeypatch, remaining, seconds):
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "dummy")
+    result = fetch_quota(BASE, FakeOpener(json.dumps({"remaining": remaining})))
+    assert result == seconds
+    assert type(result) is int
+
+
+@pytest.mark.parametrize("value", [None, ""])
+def test_s3_missing_token_raises_without_calling_opener(monkeypatch, value):
+    if value is None:
+        monkeypatch.delenv("TIMEPARSE_TOKEN", raising=False)
+    else:
+        monkeypatch.setenv("TIMEPARSE_TOKEN", value)
+    opener = FakeOpener()
+    with pytest.raises(MissingTokenError):
+        fetch_quota(BASE, opener)
+    assert opener.calls == 0
+    assert issubclass(MissingTokenError, RuntimeError)
+
+
+def test_s4_token_read_on_each_call(monkeypatch):
+    opener = FakeOpener()
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "a")
+    fetch_quota(BASE, opener)
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "b")
+    fetch_quota(BASE, opener)
+    assert [r.get_header("Authorization") for r in opener.requests] == [
+        "Bearer a",
+        "Bearer b",
+    ]
diff --git a/timeparse/quota.py b/timeparse/quota.py
new file mode 100644
index 0000000..d48e7e5
--- /dev/null
+++ b/timeparse/quota.py
@@ -0,0 +1,35 @@
+"""Client for the quota service."""
+
+from __future__ import annotations
+
+import json
+import os
+import urllib.request
+from collections.abc import Callable
+from typing import Any
+
+from .parse import parse_duration
+
+
+class MissingTokenError(RuntimeError):
+    """TIMEPARSE_TOKEN is unset or empty."""
+
+
+def fetch_quota(
+    base_url: str,
+    opener: Callable[[urllib.request.Request], Any] = urllib.request.urlopen,
+) -> int:
+    """Return the seconds remaining in the quota, from `GET {base_url}/v1/quota`.
+
+    The bearer token is read from TIMEPARSE_TOKEN on every call. `base_url` has no trailing slash.
+    """
+    token = os.environ.get("TIMEPARSE_TOKEN")
+    if not token:
+        raise MissingTokenError("TIMEPARSE_TOKEN is not set")
+    request = urllib.request.Request(
+        f"{base_url}/v1/quota",
+        headers={"Authorization": f"Bearer {token}"},
+        method="GET",
+    )
+    body = opener(request).read()
+    return parse_duration(json.loads(body)["remaining"])
