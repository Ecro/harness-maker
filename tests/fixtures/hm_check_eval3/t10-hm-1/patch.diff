index 0000000..b58a566
--- /dev/null
+++ b/tests/test_quota.py
@@ -0,0 +1,78 @@
+"""fetch_quota against a fake opener; the token is the placeholder `dummy`, never a real one."""
+
+import io
+import urllib.request
+
+import pytest
+from timeparse.quota import MissingTokenError, fetch_quota
+
+BASE = "https://q.example"
+
+
+class Recorder:
+    def __init__(self, body: bytes = b'{"remaining": "1h30m"}') -> None:
+        self.body = body
+        self.requests: list[urllib.request.Request] = []
+
+    @property
+    def calls(self) -> int:
+        return len(self.requests)
+
+    def __call__(self, request: urllib.request.Request) -> io.BytesIO:
+        self.requests.append(request)
+        return io.BytesIO(self.body)
+
+
+@pytest.fixture
+def token(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "dummy")
+
+
+def test_fetch_quota_returns_seconds(token: None) -> None:
+    assert fetch_quota(BASE, Recorder()) == 5400
+
+
+def test_fetch_quota_builds_single_get_request(token: None) -> None:
+    recorder = Recorder()
+    fetch_quota(BASE, recorder)
+    assert recorder.calls == 1
+    request = recorder.requests[0]
+    assert isinstance(request, urllib.request.Request)
+    assert request.get_method() == "GET"
+    assert request.full_url == "https://q.example/v1/quota"
+
+
+def test_fetch_quota_sends_bearer_header(token: None) -> None:
+    recorder = Recorder()
+    fetch_quota(BASE, recorder)
+    assert recorder.requests[0].get_header("Authorization") == "Bearer dummy"
+
+
+def test_fetch_quota_reads_token_each_call(
+    token: None, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    recorder = Recorder()
+    fetch_quota(BASE, recorder)
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "other")
+    fetch_quota(BASE, recorder)
+    assert recorder.requests[1].get_header("Authorization") == "Bearer other"
+
+
+def test_fetch_quota_missing_token_raises(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("TIMEPARSE_TOKEN", raising=False)
+    recorder = Recorder()
+    with pytest.raises(MissingTokenError):
+        fetch_quota(BASE, recorder)
+    assert recorder.calls == 0
+
+
+def test_fetch_quota_empty_token_raises(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("TIMEPARSE_TOKEN", "")
+    recorder = Recorder()
+    with pytest.raises(MissingTokenError):
+        fetch_quota(BASE, recorder)
+    assert recorder.calls == 0
+
+
+def test_missing_token_error_is_runtime_error() -> None:
+    assert issubclass(MissingTokenError, RuntimeError)
diff --git a/timeparse/quota.py b/timeparse/quota.py
new file mode 100644
index 0000000..84a6fd8
--- /dev/null
+++ b/timeparse/quota.py
@@ -0,0 +1,29 @@
+"""Client for the quota service."""
+
+import json
+import os
+import urllib.request
+from collections.abc import Callable
+from typing import Any
+
+from timeparse.parse import parse_duration
+
+
+class MissingTokenError(RuntimeError):
+    """TIMEPARSE_TOKEN is unset or empty."""
+
+
+def fetch_quota(
+    base_url: str,
+    opener: Callable[[urllib.request.Request], Any] = urllib.request.urlopen,
+) -> int:
+    """Return the remaining quota in seconds from `GET {base_url}/v1/quota`."""
+    token = os.environ.get("TIMEPARSE_TOKEN")
+    if not token:
+        raise MissingTokenError("TIMEPARSE_TOKEN is not set")
+    request = urllib.request.Request(
+        f"{base_url}/v1/quota", headers={"Authorization": f"Bearer {token}"}, method="GET"
+    )
+    with opener(request) as response:
+        body = json.loads(response.read())
+    return parse_duration(body["remaining"])
