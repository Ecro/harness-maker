@@ -24,15 +24,19 @@ def _total(values: list[int]) -> int:
 
 
 def main(argv: list[str] | None = None) -> int:
-    """Print one line of seconds per argument; exit 2 on the first invalid one."""
+    """Print one line of seconds per argument; report every invalid one and exit 2."""
     args = _parser().parse_args(argv)
     results: list[int] = []
+    invalid: list[str] = []
     for text in args.durations:
         try:
             results.append(parse_duration(text))
         except ValueError:
+            invalid.append(text)
+    if invalid:
+        for text in invalid:
             print(f"error: invalid duration: {text!r}", file=sys.stderr)
-            return 2
+        return 2
     if args.total:
         print(_total(results))
         return 0
