+def test_total_reports_every_invalid(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["--total", "1h", "nope", "2x"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == _NOPE_2X
+
+
+def test_total_valid(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["--total", "1h", "30s"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "3630\n"
+    assert captured.err == ""
