@@ -0,0 +1,78 @@
+"""Token-bucket rate limiter configured with a rate string such as '10/1s'."""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Callable
+
+from timeparse.parse import parse_duration
+
+# A token counts as available when it is due to within this much, so that clock readings
+# such as 0.3 - 0.2 (== 0.0999...98) do not reject a token that is due on schedule.
+_EPSILON = 1e-9
+
+
+def _positive_int(value: object, name: str) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+        raise ValueError(f"{name} must be a positive integer, got {value!r}")
+    return value
+
+
+def _parse_rate(rate: object) -> float:
+    """Return tokens per second for an 'N/DURATION' string."""
+    if not isinstance(rate, str):
+        raise ValueError(f"rate must be a string, got {rate!r}")
+    parts = rate.split("/")
+    if len(parts) != 2:
+        raise ValueError(f"rate must look like 'N/DURATION', got {rate!r}")
+    count_text, duration_text = parts
+    if not (count_text.isascii() and count_text.isdigit()) or int(count_text) < 1:
+        raise ValueError(f"rate count must be a positive integer, got {rate!r}")
+    seconds = parse_duration(duration_text)
+    if seconds <= 0:
+        raise ValueError(f"rate duration must be positive, got {rate!r}")
+    return int(count_text) / seconds
+
+
+class RateLimiter:
+    """Token bucket: starts full, refills continuously at `rate`, holds at most `burst`."""
+
+    def __init__(
+        self, rate: str, burst: int, clock: Callable[[], float] = time.monotonic
+    ) -> None:
+        self._rate = _parse_rate(rate)
+        self._burst = _positive_int(burst, "burst")
+        self._clock = clock
+        self._tokens = float(self._burst)
+        self._last = clock()
+
+    def allow(self, n: int = 1) -> bool:
+        """Take `n` tokens and return True if they are available, else take nothing."""
+        self._check(n)
+        self._refill()
+        if self._tokens >= n - _EPSILON:
+            self._tokens = max(0.0, self._tokens - n)
+            return True
+        return False
+
+    def retry_after(self, n: int = 1) -> float:
+        """Seconds until `n` tokens are available; 0.0 if they are now. Takes nothing."""
+        self._check(n)
+        self._refill()
+        if self._tokens >= n - _EPSILON:
+            return 0.0
+        return (n - self._tokens) / self._rate
+
+    def _check(self, n: object) -> None:
+        if not isinstance(n, int) or isinstance(n, bool) or not 1 <= n <= self._burst:
+            raise ValueError(
+                f"n must be an integer between 1 and {self._burst}, got {n!r}"
+            )
+
+    def _refill(self) -> None:
+        now = self._clock()
+        if now > self._last:  # a regressing clock adds nothing and is not remembered
+            self._tokens = min(
+                float(self._burst), self._tokens + (now - self._last) * self._rate
+            )
+            self._last = now
