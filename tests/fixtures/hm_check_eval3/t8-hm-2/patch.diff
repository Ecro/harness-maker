@@ -0,0 +1,65 @@
+"""parse_duration input contract (SPEC-parse-duration-contract)."""
+
+import pytest
+from timeparse import parse_duration
+
+CAP = 2**63 - 1
+
+
+@pytest.mark.parametrize(
+    ("text", "seconds"),
+    [
+        (" 1h\t", 3600),
+        ("\n45s\n", 45),
+        ("007s", 7),
+        ("106751991167300d", 9223372036854720000),
+        ("9223372036854775807s", CAP),
+    ],
+)
+def test_s1_s5_s6_accepted(text: str, seconds: int) -> None:
+    assert parse_duration(text) == seconds
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "\u00a01h",
+        "1h\u2003",
+        "\u30001h",
+        "\x851h",
+        "\x1c1h",
+        "\r1h",
+        "1h\x0b",
+        "\x0c1h",
+        "\u00a0",
+    ],
+)
+def test_s2_other_whitespace_raises(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["+1h", "-1h", "1h-30m"])
+def test_s3_sign_raises(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["\u0661h", "\uff11h", "1h\u0662m"])
+def test_s4_non_ascii_digits_raise(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize(
+    "text", ["9223372036854775808s", "106751991167301d", "106751991167300d16h"]
+)
+def test_s6_over_cap_raises(text: str) -> None:
+    with pytest.raises(ValueError, match="^duration too large"):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize("text", ["", " \t\n"])
+def test_s7_empty_or_blank_raises(text: str) -> None:
+    with pytest.raises(ValueError, match="^empty duration$"):
+        parse_duration(text)
