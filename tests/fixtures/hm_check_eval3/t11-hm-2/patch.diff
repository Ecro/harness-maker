     captured = capsys.readouterr()
     assert captured.out == ""
     assert "nope" in captured.err
+
+
+def test_reports_every_invalid_in_order(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["1h", "nope", "2x", "30s"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert (
+        captured.err
+        == "error: invalid duration: 'nope'\nerror: invalid duration: '2x'\n"
+    )
+
+
+def test_total_reports_every_invalid_and_no_total(
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    assert main(["--total", "1h", "nope", "2x"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert (
+        captured.err
+        == "error: invalid duration: 'nope'\nerror: invalid duration: '2x'\n"
+    )
+
+
+def test_valid_arguments_unchanged(capsys: pytest.CaptureFixture[str]) -> None:
+    assert main(["1h", "30s"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "3600\n30\n"
+    assert captured.err == ""
+    assert main(["--total", "1h", "30s"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "3630\n"
+    assert captured.err == ""
diff --git a/timeparse/cli.py b/timeparse/cli.py
index 6cb13cc..f2d7cd1 100644
--- a/timeparse/cli.py
+++ b/timeparse/cli.py
@@ -24,15 +24,18 @@ def _total(values: list[int]) -> int:
 
 
 def main(argv: list[str] | None = None) -> int:
-    """Print one line of seconds per argument; exit 2 on the first invalid one."""
+    """Print one line of seconds per argument; report every invalid one and exit 2."""
     args = _parser().parse_args(argv)
     results: list[int] = []
+    invalid = False
     for text in args.durations:
         try:
             results.append(parse_duration(text))
         except ValueError:
             print(f"error: invalid duration: {text!r}", file=sys.stderr)
-            return 2
+            invalid = True
+    if invalid:
+        return 2
     if args.total:
         print(_total(results))
         return 0
