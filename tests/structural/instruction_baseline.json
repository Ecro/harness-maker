      "executables": [
        "!HM_OWNED_SESSION_UUIDS=\"$(uv run --with $HOME/harness-maker python -m harness_maker.worktree owned-crumb-read \"$(pwd)\" <slug>)\" uv run --with $HOME/harness-maker python -m harness_maker.worktree post-commit-pop \"$(pwd)\"",
