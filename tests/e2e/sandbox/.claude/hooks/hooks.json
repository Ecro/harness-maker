{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.telemetry",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.hooks.post_write_reminder",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.hooks.flush_session",
            "statusMessage": "Snapshotting autoloop progress...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "auto"
      },
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.hooks.flush_session",
            "statusMessage": "Snapshotting autoloop progress...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "manual"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.gates.permission_gate",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.gates.worktree_gate",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.hooks.sessionstart_drift",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.hooks.loop_gate --mode stop-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "preset": "Side"
}
