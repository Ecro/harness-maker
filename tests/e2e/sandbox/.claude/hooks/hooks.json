{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.telemetry",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.gates.permission_gate",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/harness-maker python -m harness_maker.gates.spec_gate",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "SessionStart": [],
    "Stop": []
  },
  "preset": "Production"
}
