{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.gates.permission_gate",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.telemetry",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.hooks.post_write_reminder",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.gates.permission_gate",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.hooks.sessionstart_drift",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.hooks.loop_gate --mode stop-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "uv run --with /home/noel/.claude/plugins/cache/harness-maker-local/harness-maker/0.9.0 python -m harness_maker.hooks.flush_session",
            "statusMessage": "Snapshotting autoloop progress...",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "preset": "Production"
}
