[features]
hooks = true

# ADR-008 (PLAN-model-routing-multi-ide): per-loop invocation profiles.
# Use `codex -p cheap "trivial turn"` to skip the reasoning step entirely
# (largest cost lever per OpenAI platform docs), or `codex -p deep "..."` for
# maximum reasoning. Both inherit your account's default model — they only
# adjust reasoning_effort. Codex hooks cannot natively pick a model, so
# cheap-precheck hook commands should shell out via `codex -p cheap ...`.
[profiles.cheap]
model_reasoning_effort = "minimal"

[profiles.deep]
model_reasoning_effort = "high"

{% for agent_name, agent_desc in agents.items() %}
[agents.{{ agent_name }}]
config_file = "agents/{{ agent_name }}.toml"
description = {{ agent_desc | tojson }}
{% endfor %}
{% if config.mcp_servers -%}
{% for server_name, server_cfg in config.mcp_servers.items() %}
[mcp_servers."{{ server_name }}"]
command = {{ server_cfg.command | tojson }}
{%- if server_cfg.get("args") %}
args = {{ server_cfg.args | tojson }}
{%- endif %}
{%- if server_cfg.get("env") %}
{%- for env_k, env_v in server_cfg.env.items() %}
env.{{ env_k }} = {{ env_v | tojson }}
{%- endfor %}
{%- endif %}
{% endfor %}
{%- endif %}

