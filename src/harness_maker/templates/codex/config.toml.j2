[features]
hooks = true

# ADR-008 (PLAN-model-routing-multi-ide): per-loop invocation profiles
# (`codex -p cheap` / `codex -p deep`) live in your USER-level config —
# `~/.codex/config.toml` — not here. Codex CLI v0.130+ rejects
# `[profiles.*]` in project-local `.codex/config.toml` with
# "Ignored unsupported project-local config keys ... profiles".
# `harness-maker make` (when codex is a target) idempotently installs
# `[profiles.cheap]` (`model_reasoning_effort = "minimal"`) and
# `[profiles.deep]` (`"high"`) into `~/.codex/config.toml`. Per-project
# tuning happens via `.codex/agents/<name>.toml` `model_reasoning_effort`
# instead, which IS honored at the project level.

{% for agent_name, agent_desc in agents.items() %}
[agents.{{ agent_name }}]
config_file = "agents/{{ agent_name }}.toml"
description = {{ agent_desc | tojson }}
{% endfor %}
{% if config.mcp_servers -%}
{% for server_name, server_cfg in config.mcp_servers.items() %}
[mcp_servers."{{ server_name }}"]
command = {{ server_cfg.command | tojson }}
{%- if server_cfg.get("args") %}
args = {{ server_cfg.args | tojson }}
{%- endif %}
{%- if server_cfg.get("env") %}
{%- for env_k, env_v in server_cfg.env.items() %}
env.{{ env_k }} = {{ env_v | tojson }}
{%- endfor %}
{%- endif %}
{% endfor %}
{%- endif %}

