[features]
hooks = true

# Per-project model tuning lives in `.codex/agents/<name>.toml`
# (`model_reasoning_effort`), which Codex honours at the project level.

{% for agent_name, agent_desc in agents.items() %}
[agents.{{ agent_name }}]
config_file = "agents/{{ agent_name }}.toml"
description = {{ agent_desc | tojson }}
{% endfor %}
{% if config.mcp_servers -%}
{% for server_name, server_cfg in config.mcp_servers.items() %}
[mcp_servers."{{ server_name }}"]
command = {{ server_cfg.command | tojson }}
{%- if server_cfg.get("args") %}
args = {{ server_cfg.args | tojson }}
{%- endif %}
{%- if server_cfg.get("env") %}
{%- for env_k, env_v in server_cfg.env.items() %}
env.{{ env_k }} = {{ env_v | tojson }}
{%- endfor %}
{%- endif %}
{% endfor %}
{%- endif %}

# @hm:user:extensions
# Add custom Codex configuration here ([mcp_servers."..."], [agents.NAME], etc.).
# Content between these markers is preserved across `harness-maker make` re-renders
# (PLAN-onboarding-backup-friction Phase 2, ADR-004/007).
