preset: {{ config.preset }}
locale: {{ config.locale }}
targets: [{{ config.targets | join(', ') }}]
default_model: {{ config.default_model }}
dev_mode: {{ config.dev_mode }}
caching: {{ config.caching }}
schema_version: {{ config.schema_version }}
interview:
  deep_gate:
    # 0.16.0: 5-term inequality gate (PLAN-deep-interview-question-criteria).
    eig_epsilon: {{ config.interview.deep_gate.eig_epsilon }}
    confidence_tau: {{ config.interview.deep_gate.confidence_tau }}
    open_ended_cap_by_locale:
      en: {{ config.interview.deep_gate.open_ended_cap_by_locale.en }}
      ko: {{ config.interview.deep_gate.open_ended_cap_by_locale.ko }}
      ja: {{ config.interview.deep_gate.open_ended_cap_by_locale.ja }}
      default: {{ config.interview.deep_gate.open_ended_cap_by_locale.default }}
    common_ground:
      llm_inference_threshold: {{ config.interview.deep_gate.common_ground.llm_inference_threshold }}
      llm_inference_enabled: {{ config.interview.deep_gate.common_ground.llm_inference_enabled | lower }}
  main_loop:
    max_rounds: {{ config.interview.main_loop.max_rounds | default('null', true) }}
  comprehension:
    # PLAN-plan-interview-comprehension: minimal | standard | deep.
    # `.get()` not bare attribute access — a hand-built `interview` dict (several tests
    # construct one) has no `comprehension` key and bare access raises UndefinedError.
    depth: {{ (config.interview.get('comprehension') or {}).get('depth', 'standard') }}
project:
  domains: [{{ config.project.domains | join(", ") }}]
spec:
  dir: {{ config.spec.dir }}
work_docs:
  dir: {{ config.work_docs.dir }}
ref_folders:
{% for f in config.ref_folders %}  - path: {{ f.path | tojson }}
    glob: {{ f.glob | tojson }}
{% endfor %}
second_brain:
  enabled: {{ config.second_brain.enabled | lower }}
  backend: {{ config.second_brain.backend | tojson }}
  project_id: {{ config.second_brain.project_id | tojson }}
  vault_path: {{ config.second_brain.vault_path | tojson }}
  required_frontmatter: {{ config.second_brain.required_frontmatter | tojson }}
{% if config.second_brain.folders %}
  folders:
{% for f in config.second_brain.folders %}    - path: {{ f.path | tojson }}
      read: {{ f.read | lower }}
      write: {{ f.write | lower }}
      note_types: {{ f.note_types | tojson }}
{% endfor %}
{% else %}
  folders: []
{% endif %}
sibling_repos:
{% for r in config.sibling_repos %}  - {{ r | tojson }}
{% endfor %}
wrapup_docs:
{% for d in config.wrapup_docs %}  - {{ d | tojson }}
{% endfor %}
{%- if config.toolchains %}
toolchains:
{% for t in config.toolchains %}  - name: {{ t.name | tojson }}
    extensions:{% if not t.extensions %} []{% endif %}
{% for e in t.extensions %}      - {{ e | tojson }}
{% endfor %}    commands:{% if not (t.commands.test or t.commands.lint or t.commands.types) %} {}{% endif %}
{% if t.commands.test %}      test: {{ t.commands.test | tojson }}
{% endif %}{% if t.commands.lint %}      lint: {{ t.commands.lint | tojson }}
{% endif %}{% if t.commands.types %}      types: {{ t.commands.types | tojson }}
{% endif %}{% endfor %}{%- endif %}
reviewers:
  consensus: {{ config.reviewers.consensus }}
  verbosity: {{ config.reviewers.verbosity }}
  auto_fix: {{ config.reviewers.auto_fix | lower }}
  grade_threshold: {{ config.reviewers.grade_threshold }}
  max_review_rounds: {{ config.reviewers.max_review_rounds }}
{% if config.reviewers.mechanical_checks %}
  mechanical_checks:
{% for c in config.reviewers.mechanical_checks %}    - {{ c | tojson }}
{% endfor %}{% endif %}
  installed:
{% for r in config.reviewers.installed %}    - {{ r }}
{% endfor %}  enabled:
{% for r in config.reviewers.enabled %}    - {{ r }}
{% endfor %}
skills:
  installed:
{% for s in skills.installed %}    - {{ s }}
{% endfor %}  enabled:
{% for s in skills.enabled %}    - {{ s }}
{% endfor %}
worktree:
  enabled: {{ config.worktree['enabled'] | tojson }}
memory:
  enabled: true
  dir: .claude/memory
  files: [failures.md, wiki.md]
security:
  on_finding:
    high: block
    medium: log
  gates:
    spec_gate: block
feedback:
  enabled: {{ (config.feedback.enabled if config.feedback else false) | string | lower }}
second_opinion:
  models: {{ (config.second_opinion.models if config.second_opinion else []) | tojson }}
  agents: {{ (config.second_opinion.agents if config.second_opinion else ['code-reviewer', 'consensus-arbiter', 'plan-validator']) | tojson }}
  failure_policy: {{ (config.second_opinion.failure_policy if config.second_opinion else "warn-and-proceed") | tojson }}
  codex:
    hermetic: {{ (config.second_opinion.codex.hermetic if config.second_opinion else true) | string | lower }}
    output_schema_path: {{ (config.second_opinion.codex.output_schema_path if config.second_opinion else ".claude/schemas/second-opinion-finding.schema.json") | tojson }}
  antigravity:
    model: {{ (config.second_opinion.antigravity.model if config.second_opinion else "Gemini 3.6 Flash (High)") | tojson }}
delivery_metrics:
  tag_pattern: {{ (config.delivery_metrics.tag_pattern if config.delivery_metrics else "v*") | tojson }}
  default_branch: {{ (config.delivery_metrics.default_branch if config.delivery_metrics else none) | tojson }}
  cfr_window_days: {{ (config.delivery_metrics.cfr_window_days if config.delivery_metrics else 28) }}
  churn_maturation_days: {{ (config.delivery_metrics.churn_maturation_days if config.delivery_metrics else 14) }}
  churn_cohort_days: {{ (config.delivery_metrics.churn_cohort_days if config.delivery_metrics else 14) }}
  blame_file_cap: {{ (config.delivery_metrics.blame_file_cap if config.delivery_metrics else 500) }}
  paths: {{ (config.delivery_metrics.paths if config.delivery_metrics else []) | tojson }}
economics:
  window_days: {{ (config.economics.window_days if config.economics else 30) }}
  price_model: {{ (config.economics.price_model if config.economics else "opus") | tojson }}
  adjacency_estimate: {{ (config.economics.adjacency_estimate if config.economics else true) | string | lower }}
  adjacency_max_gap_min: {{ (config.economics.adjacency_max_gap_min if config.economics else 10.0) }}
  adjacency_max_turns: {{ (config.economics.adjacency_max_turns if config.economics else 20) }}
  idle_gap_cap_min: {{ (config.economics.idle_gap_cap_min if config.economics else 5.0) }}
  span_max_turns: {{ (config.economics.span_max_turns if config.economics else 400) }}
  span_max_min: {{ (config.economics.span_max_min if config.economics else 240.0) }}
delegation:
  stages: {{ (config.delegation.stages if config.delegation else []) | tojson }}
autonomy:
  level: {{ (config.autonomy.level if config.autonomy else "ask") | tojson }}
  pipeline: {{ (config.autonomy.pipeline if config.autonomy else ['research', 'spec', 'plan', 'execute', 'review', 'verify', 'wrapup']) | tojson }}
  step_cap: {{ (config.autonomy.step_cap if config.autonomy else 20) | tojson }}
  time_cap_min: {{ (config.autonomy.time_cap_min if config.autonomy else 300) | tojson }}
  extra_deny: {{ (config.autonomy.extra_deny if config.autonomy else []) | tojson }}
  autopilot_persistent: {{ (config.autonomy.autopilot_persistent if config.autonomy else true) | tojson }}
instrumentation:
  # harness-maker's own development telemetry. false = this project stops emitting
  # stage_agent_ledger rows AND leaves the cross-project denominator.
  stage_agent_ledger: {{ (config.instrumentation.stage_agent_ledger if config.instrumentation else true) | tojson }}
