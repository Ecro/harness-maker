{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Bash",
        "command": "PATH=\"$HOME/.local/bin:$PATH\" uv run --with {{ harness_maker_src_path }} python -m harness_maker.gates.permission_gate"
      }{% if config.dev_mode == "spec-driven" %},
      {
        "matcher": "Write|Edit",
        "command": "PATH=\"$HOME/.local/bin:$PATH\" uv run --with {{ harness_maker_src_path }} python -m harness_maker.gates.spec_gate"
      }{% endif %}
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "PATH=\"$HOME/.local/bin:$PATH\" uv run --with {{ harness_maker_src_path }} python -m harness_maker.telemetry"
      }
    ],
    "preCompact": [
      {
        "command": "PATH=\"$HOME/.local/bin:$PATH\" uv run --with {{ harness_maker_src_path }} python -m harness_maker.hooks.flush_session",
        "timeout": 30
      }
    ]
  }
}
