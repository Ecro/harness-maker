{#- Cursor-native hooks schema: lowercase camelCase event keys + version: 1 + flat
    {matcher, command} shape. This is DELIBERATELY DIFFERENT from
    templates/hooks/hooks.json.j2 (Claude Code: PascalCase + nested {hooks:[]}).

    Each IDE owns its own hooks file with its own schema:
      - Cursor reads .cursor/hooks.json (this file)
      - Claude Code reads project hooks ONLY from settings.json's `hooks` key
        (confirmed 2026-07-17; `.claude/hooks/hooks.json` is a plugin-bundle path
        Claude Code never reads for a plain project)

    Verified empirically via kairos 0.5.7 forensic on 2026-05-08:
    metrics.jsonl entries had `event: "stop"` (lowercase) + Cursor-only
    `status` + `loop_count` payload fields → unambiguous Cursor origin.
    See tests/cursor-compat/results-2026-05-08.md for full evidence.

    Do NOT "fix" this to match the Claude PascalCase shape. Cursor will
    stop firing hooks. The dual-render is by design.

    The `postToolUse` hook (added 2026-05-08) mirrors Claude Code's
    PostToolUse → telemetry wiring. Cursor does NOT surface token usage
    in any hook event (confirmed by Cursor team), so cost_usd will be
    null for entries from this hook — but tool_name + timestamp still
    give a per-call timeline that the prior stop-only render lacked.
-#}
{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Bash",
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.hooks.loop_gate --mode pretooluse"
      },
      {
        "matcher": "Bash",
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.gates.permission_gate"
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.gates.worktree_gate"
      }{% if config.dev_mode == "spec-driven" %},
      {
        "matcher": "Write|Edit",
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.gates.spec_gate"
      }{% endif %}
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.telemetry"
      }
    ],
    "stop": [
      {
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.telemetry"
      }
    ],
    "preCompact": [
      {
        "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}\" PATH=\"$HOME/.local/bin:$PATH\" uv run --with \"{{ harness_maker_src_path }}\" python -m harness_maker.hooks.flush_session",
        "timeout": 30
      }
    ]
  }
}
