{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "uv run --with {{ harness_maker_src_path }} python -m harness_maker.telemetry"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "uv run --with {{ harness_maker_src_path }} python -m harness_maker.gates.permission_gate"}
        ]
      }{% if config.dev_mode == "spec-driven" %},
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "uv run --with {{ harness_maker_src_path }} python -m harness_maker.gates.spec_gate"}
        ]
      }{% endif %}
    ],
    "SessionStart": [],
    "Stop": []
  },
  "preset": "{{ preset }}"
}
