---
name: concurrency-reviewer
communication_variant: reframe
description: Reviews changes for race conditions, deadlocks, ISR safety, and async correctness
tools: Read, Grep, Glob
model: sonnet
review_scope: [concurrency]
permissions:
  allow:
    - "Read(*)"
    - "Grep(*)"
    - "Glob(*)"
    - "Bash(git diff:*)"
    - "Bash(git log:*)"
    - "Bash(git status:*)"
  deny:
    - "Write(*)"
    - "Edit(*)"
    - "Bash(rm:*)"
    - "Bash(curl:*)"
    - "Bash(npm:*)"
    - "Bash(eval *)"
    - "Bash(python:*)"
    - "Bash(node:*)"
    - "Bash(sh:*)"
    - "Bash(bash:*)"
---

