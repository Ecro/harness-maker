    - "Write(*)"
    - "Edit(*)"
    - "Bash(rm:*)"
    - "Bash(curl:*)"
    - "Bash(npm:*)"
    - "Bash(eval *)"
    - "Bash(python:*)"
    - "Bash(node:*)"
    - "Bash(sh:*)"
    - "Bash(bash:*)"
