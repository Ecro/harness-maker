---
name: code-reviewer
communication_variant: reframe
description: Reviews code changes for correctness, readability, maintainability, and basic security/performance hygiene
tools: Read, Grep, Glob
model: {% if cursor_model is defined and cursor_model is not none %}{{ cursor_model }}{% elif claude_model is defined and claude_model is not none %}{{ claude_model }}{% else %}sonnet{% endif %}
review_scope: [code]
permissions:
  allow:
    - "Read(*)"
    - "Grep(*)"
    - "Glob(*)"
    - "Bash(git diff:*)"
    - "Bash(git log:*)"
    - "Bash(git status:*)"
{%- include "agents/_partials/codex_permission_line.md.j2" %}
  deny:
    - "Write(*)"
    - "Edit(*)"
    - "Bash(rm:*)"
    - "Bash(curl:*)"
    - "Bash(npm:*)"
    - "Bash(eval *)"
    - "Bash(python:*)"
    - "Bash(node:*)"
    - "Bash(sh:*)"
    - "Bash(bash:*)"
---

{% include "agents/code-reviewer_body.md.j2" -%}
