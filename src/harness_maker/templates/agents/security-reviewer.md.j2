---
name: security-reviewer
description: Reviews changes for secrets exposure, injection, auth flaws, and unsafe permission grants
tools: Read, Grep, Glob
model: sonnet
review_scope: [security]
permissions:
  allow:
    - "Read(*)"
    - "Grep(*)"
    - "Glob(*)"
    - "Bash(git diff:*)"
    - "Bash(git log:*)"
    - "Bash(git status:*)"
  deny:
    - "Write(*)"
    - "Edit(*)"
    - "Bash(rm:*)"
    - "Bash(curl:*)"
    - "Bash(npm:*)"
    - "Bash(eval *)"
    - "Bash(python:*)"
    - "Bash(node:*)"
    - "Bash(sh:*)"
    - "Bash(bash:*)"
---

