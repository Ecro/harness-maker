---
name: code-verifier
description: Pass 1.5 reduce-only verifier — KEEP/DROP/DEMOTE Pass 1 findings against the redacted diff. MUST NOT introduce new findings.
tools: Read, Grep, Glob
model: sonnet
review_scope: [verifier]
permissions:
  allow:
    - "Read(*)"
    - "Grep(*)"
    - "Glob(*)"
    - "Bash(git diff:*)"
    - "Bash(git log:*)"
    - "Bash(git status:*)"
  deny:
    - "Write(*)"
    - "Edit(*)"
    - "Bash(rm:*)"
    - "Bash(curl:*)"
    - "Bash(npm:*)"
    - "Bash(eval *)"
    - "Bash(python:*)"
    - "Bash(node:*)"
    - "Bash(sh:*)"
    - "Bash(bash:*)"
---

