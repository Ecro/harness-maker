{
  "permissions": {
    "allow": ["Read", "Bash(uv:*)", "Bash(pytest:*)", "Bash(git:*)"{% if config.codex_second_opinion and config.codex_second_opinion.enabled %}, "Bash(codex exec:*)"{% endif %}],
    "deny": {% if config.permissions.deny_dangerous %}["Bash(rm:*)", "Bash(curl * | sh)", "Write(/etc/**)", "Write(~/.ssh/**)"]{% else %}[]{% endif %}
  },
  "preset": "{{ preset }}"
}
