{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "uv run python -m harness_maker.telemetry"}
        ]
      }
    ],
    "PreToolUse": [{% if config.dev_mode == "spec-driven" %}
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "uv run python -m harness_maker.gates.spec_gate"}
        ]
      }{% endif %}
    ],
    "SessionStart": [],
    "Stop": []
  },
  "preset": "{{ preset }}"
}
